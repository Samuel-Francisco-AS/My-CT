#!/usr/bin/python3
"""Read-only inventory of My-CT Jellyfin media folders (no Jellyfin API needed)."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import sys

CORE = Path(__file__).with_name('myct-media')
if not CORE.is_file() or CORE.is_symlink():
    raise SystemExit('Instale myct-media ao lado de myct-media-library.')
loader = importlib.machinery.SourceFileLoader('myct_media_library_core', str(CORE))
spec = importlib.util.spec_from_loader(loader.name, loader)
core = importlib.util.module_from_spec(spec)
loader.exec_module(core)

TYPES = [('anime', 'Series'), ('series', 'Series-TV'), ('movie', 'Filmes')]
SEASON = re.compile(r'^Season (\d{1,2})$', re.I)
EPISODE = re.compile(r'(?<![0-9A-Za-z])S(\d{1,2})E(\d{1,3})(?![0-9A-Za-z])', re.I)
YEAR_SUFFIX = re.compile(r'^(.*?) \((19\d{2}|20\d{2})\)$')
MAX_TITLES = 250
MAX_VIDEOS = 2000


def regular_videos(folder):
    if not folder.is_dir() or folder.is_symlink():
        return []
    return [f for f in sorted(folder.iterdir()) if
            f.is_file() and not f.is_symlink() and f.suffix.lower() in core.VIDEO]


def inspect(root=None, state=None):
    root = root or core.media_root()
    if root.is_symlink():
        raise core.MediaError('Raiz Media não pode ser link simbólico.')
    if not root.exists():
        return {'groups': []}
    if not root.is_dir():
        raise core.MediaError('Biblioteca Media inválida.')
    known = (state if state is not None else core.load_state())['links']
    result = []
    videos_seen = 0
    for kind, dirname in TYPES:
        base = root / dirname
        if not base.exists():
            continue
        if base.is_symlink() or not base.is_dir():
            raise core.MediaError('Raiz de biblioteca inválida: ' + dirname)
        for folder in sorted(base.iterdir()):
            if not folder.is_dir() or folder.is_symlink():
                continue
            if len(result) >= MAX_TITLES:
                raise core.MediaError('Biblioteca excede o limite de 250 títulos.')
            folder_name = folder.name
            match = YEAR_SUFFIX.fullmatch(folder_name)
            title = match.group(1) if match else folder_name
            year = int(match.group(2)) if match else None
            if not title or len(title) > 100:
                continue
            path = dirname + '/' + folder_name
            seasons = []
            managed_count = 0
            total_files = 0
            if kind == 'movie':
                files = regular_videos(folder)
                total_files = len(files)
                videos_seen += total_files
                managed_count = sum((path + '/' + item.name) in known for item in files)
            else:
                for subfolder in sorted(folder.iterdir()):
                    season_match = SEASON.fullmatch(subfolder.name)
                    if not season_match or subfolder.is_symlink() or not subfolder.is_dir():
                        continue
                    number = int(season_match.group(1))
                    files = regular_videos(subfolder)
                    videos_seen += len(files)
                    total_files += len(files)
                    episodes = set()
                    unknown = 0
                    season_managed = 0
                    for item in files:
                        relative = path + '/' + subfolder.name + '/' + item.name
                        if relative in known:
                            season_managed += 1
                        found = EPISODE.search(item.stem)
                        if found and int(found.group(1)) == number:
                            episodes.add(int(found.group(2)))
                        else:
                            unknown += 1
                    managed_count += season_managed
                    episodes = sorted(episodes)
                    missing = [i for i in range(1, max(episodes) + 1) if i not in episodes] if episodes else []
                    seasons.append({'number': number, 'episodes': episodes, 'missing': missing,
                                    'files': len(files), 'unidentified': unknown,
                                    'managed': season_managed})
            if videos_seen > MAX_VIDEOS:
                raise core.MediaError('Biblioteca excede o limite de 2000 vídeos.')
            result.append({'kind': kind, 'folder': folder_name, 'title': title,
                           'path': path, 'year': year, 'files': total_files,
                           'managed': managed_count, 'seasons': seasons})
    return {'groups': result}


def main():
    if sys.argv[1:] != ['list']:
        print('Uso: myct-media-library list', file=sys.stderr)
        return 2
    try:
        print(json.dumps(inspect(), ensure_ascii=False))
        return 0
    except (core.MediaError, OSError, ValueError, KeyError) as exc:
        print(str(exc) if isinstance(exc, core.MediaError) else
              'Falha ao consultar a biblioteca.', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())

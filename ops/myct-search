#!/usr/bin/python3
"""SSH-facing Prowlarr adapter. Python standard library only."""
import base64
from collections import deque
from datetime import datetime, timezone
import hashlib
import http.client
import json
import ipaddress
import socket
import subprocess
import time
from functools import lru_cache
import os
from pathlib import Path
import re
import stat
import sys
from urllib.parse import parse_qs, unquote, urlencode, urlsplit
import xml.etree.ElementTree as ET

PORT = 9696
RESULT_LIMIT = 20
TOTAL_LIMIT = 500
MAX_PAGE = TOTAL_LIMIT // RESULT_LIMIT
RESPONSE_LIMIT = 2 * 1024 * 1024
META_LIMIT = 4 * 1024 * 1024
OUTPUT_LIMIT = 256 * 1024
MAGNET_LIMIT = 8192


class Failure(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def api_key():
    # Reuse the existing private Prowlarr config; never copy or rewrite it.
    path = Path.home() / '.local/share/myct/prowlarr/config.xml'
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, 'rb') as stream:
            meta = os.fstat(stream.fileno())
            if (not stat.S_ISREG(meta.st_mode) or meta.st_uid != os.getuid()
                    or meta.st_mode & 0o077 or meta.st_size > 65536):
                raise Failure('config', 'Configuração Prowlarr deve ser privada e pertencer ao usuário.')
            key = ET.fromstring(stream.read(65537)).findtext('ApiKey', '').strip()
        if not re.fullmatch(r'[a-fA-F0-9]{32}', key):
            raise ValueError
        return key
    except (OSError, ET.ParseError, ValueError):
        raise Failure('config', 'Não foi possível ler a API key na configuração privada do Prowlarr.') from None


def text(value, key, limit):
    if not isinstance(value, str):
        return None
    # Whitelist fields and redact the key even if echoed in a title/name.
    value = re.sub(re.escape(key), '[redacted]', value, flags=re.IGNORECASE)
    value = re.sub(r'https?://\S+', '[link omitido]', value, flags=re.IGNORECASE)
    value = ''.join(c if c.isprintable() else ' ' for c in value).strip()
    return value[:limit] or None


def number(value):
    return value if type(value) is int and 0 <= value <= 2**63 - 1 else None


class Api:
    def __init__(self, key):
        self.key = key

    def get(self, path, timeout=7):
        # Fixed loopback; no environment proxy, redirects, URL-based key or retries.
        conn = http.client.HTTPConnection('127.0.0.1', PORT, timeout=timeout)
        try:
            conn.request('GET', path, headers={'X-Api-Key': self.key, 'Accept': 'application/json'})
            response = conn.getresponse()
            if response.status in (401, 403):
                raise Failure('authentication', 'Prowlarr recusou a autenticação; confira a API key local.')
            if response.status != 200:
                raise Failure('upstream', 'Prowlarr recusou a consulta. Confira os indexadores na interface local.')
            payload = response.read(RESPONSE_LIMIT + 1)
            if len(payload) > RESPONSE_LIMIT:
                raise Failure('response_limit', 'Resposta Prowlarr excedeu 2 MiB; refine a pesquisa.')
            return json.loads(payload)
        except TimeoutError:
            raise Failure('timeout', 'Prowlarr excedeu o tempo de espera.') from None
        except (OSError, http.client.HTTPException):
            raise Failure('connection', 'Prowlarr indisponível em 127.0.0.1:9696.') from None
        except (ValueError, UnicodeError, RecursionError):
            raise Failure('invalid_response', 'Resposta JSON inválida do Prowlarr.') from None
        finally:
            conn.close()


    def download(self, path):
        conn = http.client.HTTPConnection('127.0.0.1', PORT, timeout=15)
        deadline = time.monotonic() + 20
        try:
            conn.request('GET', path, headers={'X-Api-Key': self.key, 'Accept': 'application/x-bittorrent'})
            response = conn.getresponse()
            if response.status in (401, 403):
                raise Failure('authentication', 'Autenticação recusada ao obter .torrent.')
            if 300 <= response.status < 400:
                raise Failure('download_redirect', 'A fonte redirecionou em vez de entregar .torrent; nenhum redirect foi seguido.')
            if response.status in (404, 410):
                raise Failure('expired_file', 'Arquivo expirado ou indisponível. Pesquise novamente.')
            if response.status != 200:
                raise Failure('download_unavailable', 'Indexador não entregou .torrent. Tente outra fonte mais tarde.')
            if 'html' in response.getheader('Content-Type', '').lower():
                raise Failure('html_response', 'Fonte devolveu HTML/login/CAPTCHA em vez de .torrent.')
            length = response.getheader('Content-Length')
            if length is not None and (not length.isdigit() or len(length) > 10 or int(length) > META_LIMIT):
                raise Failure('file_limit', 'Arquivo .torrent excede 4 MiB ou possui tamanho inválido.')
            data = bytearray()
            while response.fp is not None:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError()
                # read1 avoids indefinitely waiting for a full buffer on a slow stream.
                response.fp.raw._sock.settimeout(min(15, remaining))
                block = response.read1(min(65536, META_LIMIT + 1 - len(data)))
                if not block:
                    break
                data.extend(block)
                if len(data) > META_LIMIT:
                    raise Failure('file_limit', 'Arquivo .torrent excede 4 MiB.')
            raw = bytes(data)
            if raw.lstrip().startswith(b'<'):
                raise Failure('html_response', 'Fonte devolveu HTML/XML em vez de .torrent.')
            if not raw.startswith(b'd') or (length is not None and len(raw) != int(length)):
                raise Failure('invalid_metainfo', 'Resposta não contém metadados .torrent completos.')
            return raw
        except TimeoutError:
            raise Failure('timeout', 'Tempo limite ao obter arquivo .torrent.') from None
        except (OSError, http.client.HTTPException):
            raise Failure('connection', 'Conexão interrompida ao obter .torrent; consulte Downloads antes de repetir.') from None
        finally:
            conn.close()


def add_metainfo(raw, expected=None):
    helper = Path.home() / '.local/bin/myct-torrent'
    try:
        command = [str(helper), 'add-metainfo-stdin'] + ([expected] if expected else [])
        result = subprocess.run(command, input=raw, capture_output=True, timeout=25)
        if result.returncode != 0:
            # Helper stderr may contain third-party RPC text. Never forward it.
            raise Failure('metainfo_rejected', 'Metadados recusados ou Transmission indisponível. Atualize os helpers e consulte Downloads antes de repetir.')
        reply = json.loads(result.stdout)
        if (type(reply.get('duplicate')) is not bool or type(reply.get('id')) is not int or reply['id'] < 0
                or not isinstance(reply.get('hash'), str) or not re.fullmatch(r'[a-fA-F0-9]{40}', reply['hash'])):
            raise ValueError()
        return {'state': 'added', 'duplicate': reply['duplicate'], 'id': reply['id'], 'hash': reply['hash']}
    except (OSError, subprocess.TimeoutExpired, ValueError, TypeError, AttributeError):
        raise Failure('addition_uncertain', 'Inclusão não confirmada. Consulte Downloads → Torrents antes de repetir; não haverá repetição automática.') from None


def indexers(api):
    rows = api.get('/api/v1/indexer')
    if not isinstance(rows, list):
        raise Failure('invalid_response', 'Lista de indexadores inválida.')
    result = []
    for row in rows:
        if (isinstance(row, dict) and row.get('enable') is True
                and row.get('protocol') == 'torrent' and number(row.get('id'))
                and text(row.get('name'), api.key, 128)):
            result.append({'id': row['id'], 'name': text(row['name'], api.key, 128)})
    unavailable = api.get('/api/v1/indexerstatus')
    if not isinstance(unavailable, list):
        raise Failure('invalid_response', 'Estado dos indexadores inválido.')
    blocked = set()
    for row in unavailable:
        if not isinstance(row, dict) or not row.get('disabledTill'):
            continue
        try:
            until = datetime.fromisoformat(row['disabledTill'].replace('Z', '+00:00'))
            if until > datetime.now(timezone.utc):
                blocked.add(row.get('indexerId'))
        except (ValueError, TypeError, AttributeError):
            raise Failure('invalid_response', 'Disponibilidade de indexador inválida.') from None
    for source in result:
        source['available'] = source['id'] not in blocked
    if not result:
        raise Failure('no_indexers', 'Nenhum indexador torrent habilitado no Prowlarr.')
    return result


def link(value, key):
    if (not isinstance(value, str) or not value or len(value) > MAGNET_LIMIT
            or any(not c.isprintable() or c.isspace() for c in value)):
        return 'none', None
    try:
        uri = urlsplit(value)
        if uri.scheme in ('http', 'https') and uri.hostname:
            # Classify only. Do not return URLs, which can contain API keys/passkeys.
            return ('torrent_url' if uri.path.lower().endswith('.torrent') else 'indirect_url'), None
        if uri.scheme != 'magnet' or uri.netloc or uri.path or uri.fragment:
            return 'none', None
        if key.lower() in unquote(value).lower():
            return 'none', None
        query = parse_qs(uri.query)
        hashes = query.get('xt', [])
        if not any(re.fullmatch(r'urn:btih:(?:[a-fA-F0-9]{40}|[A-Za-z2-7]{32})', h) for h in hashes):
            return 'none', None
        # Keep direct v1 magnets, but never forward tracker URLs/passkeys or extras.
        value = 'magnet:?xt=' + next(h for h in hashes if re.fullmatch(
            r'urn:btih:(?:[a-fA-F0-9]{40}|[A-Za-z2-7]{32})', h))
        name = text(query.get('dn', [None])[0], key, 512)
        if name:
            value += '&' + urlencode({'dn': name})
        return 'magnet', value
    except ValueError:
        return 'none', None


@lru_cache(maxsize=128)
def public_host(host):
    try:
        if '.' not in host or host.endswith(('.local', '.localhost', '.internal', '.lan', '.home', '.test', '.invalid')):
            return False
        addresses = socket.getaddrinfo(host, 443, type=socket.SOCK_STREAM)
        return bool(addresses) and all(ipaddress.ip_address(row[4][0]).is_global for row in addresses)
    except (ValueError, OSError):
        return False


def public_page(value, key):
    """Conservative page-only subset of infoUrl; no opaque/authenticated links."""
    if not isinstance(value, str) or not 1 <= len(value) <= 2048:
        return None
    try:
        decoded = unquote(value)
        uri = urlsplit(value)
        if (uri.scheme not in ('http', 'https') or not uri.hostname or uri.username or uri.password
                or uri.port not in (None, 80 if uri.scheme == 'http' else 443)
                or uri.fragment or key.lower() in decoded.lower()
                or any(c.isspace() or not c.isprintable() for c in decoded)
                or '\\' in decoded or '%' in decoded or not public_host(uri.hostname)):
            return None
        # Only numeric public page identifiers may occur in query parameters.
        query = parse_qs(uri.query, keep_blank_values=True, strict_parsing=True)
        if any(k not in ('id', 't', 'p', 'page') or len(v) != 1 or not re.fullmatch(r'[0-9]{1,12}', v[0])
               for k, v in query.items()):
            return None
        path = unquote(uri.path).lower()
        if (any(x in path for x in ('api', 'download', 'announce', 'auth', 'login', 'token', 'passkey', 'proxy'))
                or path.endswith('.torrent') or any(x in ('.', '..') for x in path.split('/'))
                or re.search(r'[a-f0-9]{24,}|[a-z0-9_=-]{80,}', path)):
            return None
        # Recognizable detail-page routes, rather than arbitrary opaque URL paths.
        if not (re.search(r'/(?:view|torrent|torrents|details)/[0-9]+(?:/|$)', path)
                or (path.endswith(('/viewtopic.php', '/viewtorrent.php', '/details.php', '/description.php')) and query)
                or re.search(r'-torrent-[0-9]+\.html$', path)):
            return None
        return value
    except (ValueError, UnicodeError):
        return None


def reference(row):
    guid = row.get('guid')
    if not isinstance(guid, str) or not 1 <= len(guid) <= 8192 or not number(row.get('indexerId')):
        return None
    # Proxy ciphertext changes on each query, so it must not participate in identity.
    identity = [row['indexerId'], guid, row.get('title'), row.get('size'), row.get('infoHash'), row.get('infoUrl')]
    return hashlib.sha256(json.dumps(identity, ensure_ascii=True, sort_keys=True).encode()).hexdigest()


def proxy_path(value, key, indexer_id):
    if not isinstance(value, str) or len(value) > 32768 or any(not c.isprintable() or c.isspace() for c in value):
        return None
    try:
        uri = urlsplit(value)
        query = parse_qs(uri.query, keep_blank_values=True, strict_parsing=True)
        if (uri.scheme != 'http' or uri.hostname != '127.0.0.1' or uri.port != PORT
                or uri.username or uri.password or uri.fragment or uri.path != f'/{indexer_id}/download'
                or set(query) != {'apikey', 'link', 'file'} or any(len(v) != 1 or not v[0] for v in query.values())
                or query['apikey'] != [key] or not re.fullmatch(r'[A-Za-z0-9_-]{1,24000}', query['link'][0])):
            return None
        # Key goes in a header, never in the request URL constructed by this adapter.
        return uri.path + '?' + urlencode({'link': query['link'][0], 'file': query['file'][0]})
    except ValueError:
        return None


def simplify(row, key):
    if not isinstance(row, dict) or row.get('protocol') != 'torrent':
        return None
    title = text(row.get('title'), key, 512)
    if title is None:
        return None
    kind, magnet = 'none', None
    priority = {'none': 0, 'indirect_url': 1, 'torrent_url': 2, 'magnet': 3}
    # A field named magnetUrl is not necessarily a magnet (Prowlarr proxies it).
    for field in ('magnetUrl', 'downloadUrl', 'infoUrl'):
        candidate, value = link(row.get(field), key)
        if priority[candidate] > priority[kind]:
            kind, magnet = candidate, value
    magnet_source = 'direct' if magnet is not None else None
    infohash = row.get('infoHash')
    if (magnet is None and isinstance(infohash, str)
            and re.fullmatch(r'(?:[a-fA-F0-9]{40}|[A-Za-z2-7]{32})', infohash)
            and key.lower() not in infohash.lower()):
        # Minimal trackerless v1 magnet; never resolve an authenticated HTTP proxy.
        kind, magnet = 'magnet', 'magnet:?xt=urn:btih:' + infohash
        magnet_source = 'infohash'
    return {'title': title, 'size_bytes': number(row.get('size')),
            'source': text(row.get('indexer'), key, 128),
            'indexer_id': number(row.get('indexerId')),
            'seeders': number(row.get('seeders')), 'leechers': number(row.get('leechers')),
            'link_type': kind, 'magnet': magnet, 'magnet_source': magnet_source,
            'public_url': public_page(row.get('infoUrl'), key),
            'result_ref': reference(row),
            'torrent_available': bool(reference(row) and proxy_path(row.get('downloadUrl'), key, row.get('indexerId')))}


def validate_args(args):
    if args == ['status']:
        return None
    if len(args) == 6 and args[0] == 'add-torrent' and args[2] == '--indexer' and args[4] == '--result':
        options = validate_args(['search', args[1], '--indexer', args[3]])
        if re.fullmatch(r'[a-f0-9]{64}', args[5]):
            return (*options, args[5])
    if len(args) in (2, 4, 6) and args[0] == 'search':
        query = args[1].strip()
        page, indexer_id = 1, None
        seen = set()
        for flag, value in zip(args[2::2], args[3::2]):
            if flag not in ('--page', '--indexer') or flag in seen or not re.fullmatch(r'[1-9][0-9]{0,9}', value):
                break
            seen.add(flag)
            if flag == '--page':
                page = int(value)
            else:
                indexer_id = int(value)
        else:
            if (1 <= len(query) <= 200 and all(c.isprintable() for c in args[1])
                    and 1 <= page <= MAX_PAGE and (indexer_id is None or indexer_id <= 2**31 - 1)):
                return query, page, indexer_id
    raise Failure('usage', 'Uso: myct-search status | search "consulta" [--page 1–25] [--indexer ID] | add-torrent "consulta" --indexer ID --result REF.')


def result_id(item):
    # Content hash identifies the same torrent across sources and hex/Base32 forms.
    if item['magnet']:
        value = parse_qs(urlsplit(item['magnet']).query)['xt'][0].split(':')[-1]
        value = base64.b32decode(value.upper()).hex() if len(value) == 32 else value.lower()
        identity = ['btih', value]
    else:
        identity = ['metadata', item['title'].casefold(), item['size_bytes']]
        if item.get('torrent_available') or item.get('public_url'):
            # Keep actionable sources distinct; do not hide the only usable file/page.
            identity += [item.get('indexer_id'), item.get('result_ref')]
    return hashlib.sha256(json.dumps(identity, ensure_ascii=True).encode()).hexdigest()


def run(args, api):
    options = validate_args(args)
    if options is None:
        system = api.get('/api/v1/system/status')
        if not isinstance(system, dict) or system.get('appName') != 'Prowlarr' or not isinstance(system.get('version'), str):
            raise Failure('invalid_response', 'Status Prowlarr inválido.')
        return {'state': 'ready', 'version': text(system['version'], api.key, 64),
                'indexers': indexers(api), 'result_limit': RESULT_LIMIT, 'total_limit': TOTAL_LIMIT}
    query, page, indexer_id = options[:3]
    sources = indexers(api)
    if indexer_id is not None:
        sources = [source for source in sources if source['id'] == indexer_id]
        if not sources:
            raise Failure('invalid_indexer', 'Indexador removido ou desabilitado. Atualize a lista de fontes.')
        if not sources[0]['available']:
            raise Failure('indexer_unavailable', 'Indexador temporariamente indisponível. Tente outra fonte.')
    params = [('query', query), ('type', 'search')]
    params.extend(('indexerIds', source['id']) for source in sources)
    rows = api.get('/api/v1/search?' + urlencode(params), timeout=25)
    if not isinstance(rows, list):
        raise Failure('invalid_response', 'Lista de resultados inválida.')
    if len(options) == 4:
        matches = [row for row in rows if isinstance(row, dict) and row.get('protocol') == 'torrent'
                   and row.get('indexerId') == indexer_id and reference(row) == options[3]]
        if len(matches) != 1:
            raise Failure('stale_result', 'Resultado ausente ou alterado. Pesquise novamente antes de adicionar.')
        path = proxy_path(matches[0].get('downloadUrl'), api.key, indexer_id)
        if path is None:
            raise Failure('unsupported_file', 'Esta fonte não oferece arquivo .torrent pelo proxy local.')
        raw = api.download(path)
        expected = matches[0].get('infoHash')
        if isinstance(expected, str) and re.fullmatch(r'(?:[a-fA-F0-9]{40}|[A-Za-z2-7]{32})', expected):
            expected = expected.lower() if len(expected) == 40 else base64.b32decode(expected.upper()).hex()
            return add_metainfo(raw, expected)
        return add_metainfo(raw)
    groups = {source['id']: deque() for source in sorted(sources, key=lambda source: source['id'])}
    valid = 0
    for row in rows:
        item = simplify(row, api.key)
        if item is not None and item['indexer_id'] in groups:
            valid += 1
            item['id'] = result_id(item)
            groups[item['indexer_id']].append(item)
    if rows and not valid:
        raise Failure('invalid_response', 'Prowlarr não retornou resultados torrent válidos das fontes selecionadas.')
    ordered, seen = [], set()
    # Round-robin in ascending source ID, preserving each source's incoming order.
    while groups:
        for source in list(groups):
            item = groups[source].popleft() if groups[source] else None
            if not groups[source]:
                del groups[source]
            if item is not None and item['id'] not in seen:
                seen.add(item['id'])
                if len(ordered) < TOTAL_LIMIT:
                    ordered.append(item)
    start = (page - 1) * RESULT_LIMIT
    results = ordered[start:start + RESULT_LIMIT]
    has_more = start + RESULT_LIMIT < len(ordered)
    return {'state': 'results' if results else 'empty', 'results': results,
            'count': len(results), 'received_count': len(rows), 'discarded_count': len(rows) - valid,
            'truncated': len(seen) > len(results), 'result_limit': RESULT_LIMIT,
            'page': page, 'indexer_id': indexer_id, 'has_more': has_more,
            'total_count': len(ordered), 'total_limit': TOTAL_LIMIT,
            'limited': len(seen) > TOTAL_LIMIT, 'duplicate_count': valid - len(seen)}


def main(args=None):
    args = sys.argv[1:] if args is None else args
    try:
        validate_args(args)
        result = {'schema_version': 1, 'ok': True, **run(args, Api(api_key()))}
        output = json.dumps(result, ensure_ascii=True)
        if len(output.encode()) > OUTPUT_LIMIT:
            raise Failure('response_limit', 'Saída excedeu 256 KiB; refine a pesquisa.')
        print(output)
        return 0
    except Failure as error:
        print(json.dumps({'schema_version': 1, 'ok': False, 'state': 'error',
                          'error': {'code': error.code, 'message': str(error)}}, ensure_ascii=True))
        return 2 if error.code in ('usage', 'config') else 3


if __name__ == '__main__':
    sys.exit(main())

#!/usr/bin/python3
"""Operational adapter for the C++20 read-only worker; stdlib only, no daemon."""
import contextlib
import fcntl
import json
import os
from pathlib import Path
import pwd
import re
import signal
import subprocess
import sys
import tempfile
import time

HOME = Path(pwd.getpwuid(os.getuid()).pw_dir)
ROOT = HOME / '.local/share/myct'
DB = ROOT / 'clamav-db'
STATE = ROOT / 'av'
CONFIG = HOME / '.config/myct-av/freshclam.conf'
UNIT = 'myct-av-update.service'
BINARY = Path(__file__).resolve().with_name('myct-av-scan')


def command(args, timeout=10):
    return subprocess.run(args, capture_output=True, text=True, errors='replace',
                          timeout=timeout, env={**os.environ, 'LC_ALL': 'C'})


def private_dir(path):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    st = path.lstat()
    if path.is_symlink() or not path.is_dir() or st.st_uid != os.getuid() or st.st_mode & 0o077:
        raise RuntimeError(f'Diretório deve pertencer ao usuário e ter modo 0700: {path}')


def save(data):
    with tempfile.NamedTemporaryFile('w', dir=STATE, delete=False) as f:
        json.dump(data, f); f.flush(); os.fsync(f.fileno())
    os.replace(f.name, STATE / 'update.json')


def load():
    try:
        return json.loads((STATE / 'update.json').read_text())
    except FileNotFoundError:
        return {'last_attempt': None, 'last_finished': None, 'last_success': None, 'result': 'NEVER'}


@contextlib.contextmanager
def locked(wait=False):
    # Same lock across scans/updates: bounds RAM and keeps DB metadata consistent.
    fd = os.open(STATE / 'work.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        yield fd
    finally:
        os.close(fd)


def databases():
    result = []
    for name in ('main', 'daily', 'bytecode'):
        for suffix in ('cld', 'cvd'):
            p = DB / f'{name}.{suffix}'
            if p.is_file() and not p.is_symlink():
                with p.open('rb') as f:
                    fields = f.read(512).decode('ascii', errors='replace').strip().split(':')
                if len(fields) >= 9 and fields[0] == 'ClamAV-VDB':
                    try:
                        result.append({'name': name, 'version': int(fields[2]),
                                       'date': fields[1], 'timestamp': int(fields[8])})
                    except ValueError:
                        pass
                break
    return result


def engine_info():
    if not Path('/usr/bin/clamscan').is_file():
        return None
    p = command(['/usr/bin/clamscan', f'--database={DB}', '--version'])
    return p.stdout.strip() if p.returncode == 0 else None


def service():
    p = command(['/usr/bin/systemctl', '--user', 'show', UNIT,
                 '-p', 'LoadState', '-p', 'ActiveState', '-p', 'Result', '-p', 'ExecMainStatus'])
    return dict(line.split('=', 1) for line in p.stdout.splitlines() if '=' in line)


def info():
    db = databases(); engine = engine_info(); history = load()
    daily = next((d for d in db if d['name'] == 'daily'), None)
    now = time.time()
    success = history.get('last_success')
    stale = (not daily or not success or now - daily['timestamp'] > 72*3600 or
             daily['timestamp'] > now + 3600 or now - success > 72*3600)
    return {'engine': engine, 'databases': db, 'available': bool(engine and daily and len(db) == 3),
            'stale': bool(stale), 'last_success': success}


def update_status():
    s = service(); data = load()
    running = s.get('ActiveState') in ('active', 'activating', 'deactivating')
    if running:
        data['result'] = 'RUNNING'
    if data.get('result') == 'RUNNING' and not running:
        data['result'] = 'INTERRUPTED'
    if s.get('Result') not in (None, 'success') and not running:
        data['result'] = 'ERROR'
    try:
        with (STATE / 'update.log').open('rb') as f:
            f.seek(0, 2); f.seek(max(0, f.tell() - 4096)); log = f.read().decode('utf-8', 'replace')
    except FileNotFoundError:
        log = ''
    return {**info(), **data, 'running': running, 'service': s, 'progress': 'Aguardando análise em andamento.' if data.get('phase') == 'WAITING' and running else log}


def execution_failure_message(code, output):
    # Fixed summaries only: never echo private paths or arbitrary engine log lines.
    causes = (
        (r"fmap: map allocation failed|memory allocation error|cannot allocate memory|can't allocate memory",
         "ClamScan informou falha de alocação/reserva de memória. O limite de espaço virtual do worker é 2 GiB; RSS não mede esse limite"),
        (r"no space left on device|disk quota exceeded",
         "ClamScan informou falta de espaço ou cota no armazenamento temporário"),
        (r"file size limit exceeded",
         "ClamScan informou que um arquivo temporário excedeu o limite de tamanho"),
        (r"fmap\(\) failed",
         "ClamScan não conseguiu mapear o arquivo; a causa específica não foi identificada"),
        (r"can't write to |can't open .+ for writing",
         "ClamScan não conseguiu criar/escrever um temporário; confira espaço e permissões"),
    )
    for pattern, message in causes:
        if re.search(pattern, output, re.I):
            return f"{message} (exit_code={code}). Análise não concluída."
    return f"Falha de execução do clamscan (exit_code={code}). A causa não foi identificada."


def classify(raw):
    if 'error' in raw:
        return ('INCOMPLETE' if raw['error'].startswith('INCOMPLETE:') else 'ERROR'), [], raw['error']
    output = raw['engine_output']
    found = re.findall(r'^stdin: (.+) FOUND$', output, re.M)
    if raw['exit_code'] == 127 or re.search(r"can't (?:open|load).*database|no supported database|malformed database|cli_loaddb", output, re.I):
        return 'UNAVAILABLE', [], 'Motor ou base de assinaturas não pôde ser carregado.'
    partial = [x for x in found if x.startswith(('Heuristics.Limits.', 'Heuristics.Encrypted.',
                                               'Heuristics.Broken.'))]
    detections = list(dict.fromkeys(x for x in found if x not in partial))
    reason = raw['incomplete_reason']
    if partial:
        reason = '; '.join(partial)
    if raw['exit_code'] not in (0, 1) and not reason and not raw['signal']:
        return 'ERROR', detections, execution_failure_message(raw['exit_code'], output)
    # Warnings, parse failures, skipped/empty input and abnormal exits never become CLEAN.
    if reason or raw['signal'] or re.search(r'warning|error|skipp|limit.*exceed', output, re.I):
        return 'INCOMPLETE', detections, reason or 'Inspeção parcial; consulte engine_output.'
    if raw['exit_code'] == 1 and detections:
        return 'DETECTED', detections, ''
    if raw['exit_code'] == 0 and re.search(r'Scanned files:\s+[1-9]\d*', output) and 'stdin: OK' in output:
        return 'CLEAN', [], ''
    return ('ERROR' if raw['exit_code'] else 'INCOMPLETE'), detections, 'Execução falhou ou nenhum arquivo foi inspecionado.'


def scan(args):
    if len(args) not in (1, 2) or (len(args) == 2 and args[1] != '--watch-stdin'):
        raise RuntimeError('Uso: myct-av scan PATH_UTF8_HEX [--watch-stdin]')
    with locked() as lock:
        meta = info()
        if not meta['available'] or not BINARY.is_file():
            return {**meta, 'state': 'UNAVAILABLE', 'message': 'Motor, worker ou base dedicada indisponível.'}
        with tempfile.TemporaryDirectory(prefix='scan-', dir=STATE) as tmp:
            env = {**os.environ, 'MYCT_AV_TMP': tmp, 'LC_ALL': 'C'}
            with subprocess.Popen([str(BINARY), *args], stdout=subprocess.PIPE,
                                  env=env, pass_fds=(lock,)) as p:
                def cancel(signum, frame):
                    p.send_signal(signum)
                previous = {s: signal.signal(s, cancel) for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}
                try:
                    out, _ = p.communicate(timeout=190)
                except subprocess.TimeoutExpired:
                    p.terminate(); out, _ = p.communicate(timeout=5)
                finally:
                    for s, handler in previous.items():
                        signal.signal(s, handler)
        raw = json.loads(out)
        state, detections, reason = classify(raw)
        return {**meta, **raw, 'state': state, 'detections': detections, 'message': reason,
                'notice': 'Nenhuma detecção não comprova segurança. Decisão sobre o arquivo é do proprietário.'}


def update_worker():
    data = load()
    data.update(last_attempt=int(time.time()), last_finished=None, result='RUNNING', exit_code=None, phase='WAITING')
    data.pop('message', None)
    save(data)
    # A manual update waits for the bounded scan, rather than silently losing a request.
    with locked(wait=True) as lock:
        data['phase'] = 'UPDATING'; save(data)
        try:
            with (STATE / 'update.log').open('w') as log:
                p = subprocess.run(['/usr/bin/freshclam', f'--config-file={CONFIG}', '--stdout'],
                                   stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                   pass_fds=(lock,), timeout=1100,
                                   env={**os.environ, 'LC_ALL': 'C'})
            data['exit_code'] = p.returncode
            data['result'] = 'SUCCESS' if p.returncode == 0 and info()['available'] else 'ERROR'
            if data['result'] == 'SUCCESS':
                data['last_success'] = int(time.time())
        except (OSError, subprocess.TimeoutExpired) as e:
            data['result'] = 'ERROR'; data['message'] = str(e)
        finally:
            data['last_finished'] = int(time.time()); data['phase'] = 'FINISHED'; save(data)
        return data


def main(args):
    os.umask(0o077)
    private_dir(ROOT); private_dir(STATE); private_dir(DB)
    if not args:
        raise RuntimeError('Uso: myct-av status | scan HEX [--watch-stdin] | update | update-status')
    cmd, *rest = args
    if cmd == 'scan':
        return scan(rest)
    if rest:
        raise RuntimeError('Argumentos não suportados.')
    if cmd == 'status':
        meta = info()
        return {**meta, 'state': 'AVAILABLE' if meta['available'] else 'UNAVAILABLE'}
    if cmd == 'update-status':
        return update_status()
    if cmd == 'update':
        p = command(['/usr/bin/systemctl', '--user', 'start', '--no-block', UNIT])
        return {'requested': p.returncode == 0, 'message': p.stderr.strip(),
                'notice': 'Pedido aceito não confirma atualização; consultar update-status.',
                **update_status()}
    if cmd == '_update-worker':
        return update_worker()
    raise RuntimeError('Comando não suportado.')


if __name__ == '__main__':
    try:
        result = main(sys.argv[1:])
    except BlockingIOError:
        result = {'state': 'INCOMPLETE', 'message': 'BUSY: análise ou atualização já em andamento.'}
    except Exception as e:
        result = {'state': 'ERROR', 'message': str(e)}
    print(json.dumps({'version': 1, **result}, ensure_ascii=True))
    sys.exit(1 if result.get('state') in ('ERROR', 'UNAVAILABLE', 'INCOMPLETE') or
             result.get('result') in ('ERROR', 'INTERRUPTED') or result.get('requested') is False else 0)

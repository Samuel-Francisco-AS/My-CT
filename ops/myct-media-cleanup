#!/usr/bin/python3
"""My-CT Media storage cleanup: preview first, explicit confirmation thereafter.

Local deletion is independent of cloud backup and Media verification.
Only the exact previewed paths are unlinked; torrent removal always preserves data.
"""
from contextlib import ExitStack
import base64
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import stat
import sys

def load(name):
    path = Path(__file__).with_name(name)
    if not path.is_file() or path.is_symlink():
        raise RuntimeError('Instale ' + name + ' junto com myct-media-cleanup.')
    loader = importlib.machinery.SourceFileLoader('cleanup_' + name.replace('-', '_'), str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module

core = load('myct-media')
reconcile = load('myct_media_reconcile.py')
MAX_PATHS = 256
MAX_VIDEOS = 2000
TOKEN = re.compile('[A-Za-z0-9_-]{1,48000}')
LIBRARIES = ('Series', 'Series-TV', 'Filmes')


def snapshot(rows=None, state=None):
    """Safe library paths plus current source associations, including partial downloads."""
    state = state if state is not None else core.load_state()
    rows = rows if rows is not None else core.read_torrents()
    root = core.media_root()
    core.no_symlink_path(root, Path.home())
    source_by_inode = {}
    source_by_hash = {}
    by_hash = {row['hash_string']: row for row in rows}
    for source in core.media_files(rows, include_incomplete=True):
        inode = source['source'].stat()
        source_by_inode.setdefault((inode.st_dev, inode.st_ino), []).append(source)
        source_by_hash.setdefault(source['torrent'], []).append(source)
    items = []
    if root.exists():
        for dirname in LIBRARIES:
            base = root / dirname
            if not base.exists():
                continue
            if base.is_symlink() or not base.is_dir():
                raise core.MediaError('Biblioteca redirecionada: ' + dirname)
            # Existing library format: movie/<title>/<video>, tv/<title>/Season NN/<video>
            for folder in sorted(base.iterdir()):
                if folder.is_symlink() or not folder.is_dir():
                    continue
                folders = [folder] if dirname == 'Filmes' else [
                    p for p in sorted(folder.iterdir())
                    if p.is_dir() and not p.is_symlink() and re.fullmatch('Season [0-9]{2}', p.name)
                ]
                for sub in folders:
                    for file in sorted(sub.iterdir()):
                        if not file.is_file() or file.is_symlink() or file.suffix.lower() not in core.VIDEO:
                            continue
                        if len(items) >= MAX_VIDEOS:
                            raise core.MediaError('Biblioteca excede limite de 2000 vídeos.')
                        relative = str(file.relative_to(root))
                        core.safe_relative(relative)
                        inode = file.stat()
                        candidates = source_by_inode.get((inode.st_dev, inode.st_ino), [])
                        source = candidates[0] if len(candidates) == 1 else None
                        info = state['links'].get(relative)
                        matched = (source is not None and inode.st_nlink >= 2 and
                                   (info is None or
                                    core.record_matches(info, source['id'], file, source['source'])))
                        items.append({'path': relative,
                                      'bytes': inode.st_size,
                                      'torrent': source['torrent'] if source else None,
                                      'source_id': source['id'] if source else None,
                                      'source': str(source['source']) if source else None,
                                      'managed': bool(matched and info is not None),
                                      'eligible': True,
                                      'ambiguous': len(candidates) > 1,
                                      'mtime_ns': inode.st_mtime_ns, 'ctime_ns': inode.st_ctime_ns,
                                      'uid': inode.st_uid,
                                      'dev': inode.st_dev, 'ino': inode.st_ino,
                                      'nlink': inode.st_nlink})
    return {'files': items, 'sources': source_by_hash, 'torrents': by_hash}


def unpack(encoded):
    if not TOKEN.fullmatch(encoded):
        raise core.MediaError('Seleção inválida.')
    try:
        raw = base64.urlsafe_b64decode(encoded + '=' * (-len(encoded) % 4))
        data = json.loads(raw.decode('utf-8'))
    except (UnicodeError, ValueError) as e:
        raise core.MediaError('Seleção inválida.') from e
    if not isinstance(data, dict) or data.get('version') != 1:
        raise core.MediaError('Seleção incompatível.')
    if data.get('mode') not in {'links', 'storage'}:
        raise core.MediaError('Operação de exclusão inválida.')
    paths = data.get('paths')
    if not isinstance(paths, list) or not (1 <= len(paths) <= MAX_PATHS):
        raise core.MediaError('Selecione de 1 a 256 arquivos.')
    if len(paths) != len(set(paths)):
        raise core.MediaError('Há caminhos duplicados.')
    for p in paths:
        if not isinstance(p, str) or len(p) > 4096:
            raise core.MediaError('Caminho inválido.')
        core.safe_relative(p)
    return {'mode': data['mode'], 'paths': sorted(paths)}


def target(path, role):
    core.no_symlink_path(path, Path.home())
    s = path.lstat()
    if not stat.S_ISREG(s.st_mode) or s.st_uid != os.getuid():
        raise core.MediaError('Alvo não é arquivo regular do proprietário.')
    return {'path': str(path), 'role': role, 'dev': s.st_dev, 'ino': s.st_ino,
            'size': s.st_size, 'mtime_ns': s.st_mtime_ns, 'ctime_ns': s.st_ctime_ns,
            'nlink': s.st_nlink, 'uid': s.st_uid}


def preview(request, inventory):
    lookup = {item['path']: item for item in inventory['files']}
    selection = []
    targets = {}
    affected = {}
    blockers = []
    for path in request['paths']:
        row = lookup.get(path)
        if not row or not row['eligible']:
            raise core.MediaError('Arquivo ausente ou caminho inseguro; consulte novamente.')
        selection.append(row)
        item = target(core.media_root() / core.safe_relative(path), 'library')
        targets[item['path']] = item
        if request['mode'] == 'storage':
            if row.get('source'):
                original = target(Path(row['source']), 'original')
                if (original['dev'], original['ino']) != (item['dev'], item['ino']):
                    raise core.MediaError('Origem mudou; consulte novamente.')
                targets[original['path']] = original
                key = row['torrent']
                torrent = inventory['torrents'][key]
                affected[key] = {'hash': key, 'name': torrent.get('name', ''),
                                 'download_dir': torrent['download_dir'],
                                 'videos_outside_library': 0, 'examples': [],
                                 'seeding_will_stop': True}
    material = {'version': 2, 'mode': request['mode'], 'paths': request['paths'],
                'targets': sorted(targets.values(), key=lambda x: x['path']),
                'torrents': sorted(affected.values(), key=lambda x: x['hash']),
                'blocked': blockers}
    fingerprint = hashlib.sha256(json.dumps(material, sort_keys=True).encode()).hexdigest()
    return {**material, 'selected': len(selection), 'bytes': sum(f['bytes'] for f in selection),
            'can_apply': not blockers, 'fingerprint': fingerprint}


def check_at(fd, item, after_unlink=False):
    core.no_symlink_path(Path(item['path']), Path.home())
    parent = Path(item['path']).parent.stat()
    pinned = os.fstat(fd)
    if (parent.st_dev, parent.st_ino) != (pinned.st_dev, pinned.st_ino):
        raise core.MediaError('Diretório mudou durante a confirmação; consulte novamente.')
    s = os.stat(Path(item['path']).name, dir_fd=fd, follow_symlinks=False)
    fields = ('dev', 'ino', 'size', 'mtime_ns', 'uid') if after_unlink else (
        'dev', 'ino', 'size', 'mtime_ns', 'ctime_ns', 'nlink', 'uid')
    if not stat.S_ISREG(s.st_mode) or any(getattr(s, 'st_' + k) != item[k] for k in fields):
        raise core.MediaError('Arquivo mudou durante a confirmação; consulte novamente.')


def apply(request, expected, rows=None, rpc=None):
    if not re.fullmatch('[0-9a-f]{64}', expected):
        raise core.MediaError('Confirmação inválida.')
    initial = snapshot(rows)
    keys = {row['torrent'] for row in initial['files']
            if row['path'] in request['paths'] and row['torrent']}
    try:
        # Same lock order as Cloud/reconciliation. No cloud catalog or backup is required.
        with reconcile.locks(core, keys), ExitStack() as stack:
            state = core.load_state()
            inventory = snapshot(rows, state)
            plan = preview(request, inventory)
            if plan['fingerprint'] != expected or not plan['can_apply']:
                raise core.MediaError('A seleção mudou ou existe um bloqueio; consulte novamente.')
            descriptors = []
            for item in plan['targets']:
                # Pin each directory from / downward. No symlink component is followed.
                fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
                stack.callback(os.close, fd)
                for component in Path(item['path']).parts[1:-1]:
                    fd = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
                    stack.callback(os.close, fd)
                check_at(fd, item)
                descriptors.append((fd, item))
            if plan['torrents']:
                rpc = rpc if rpc is not None else load('myct-torrent').Rpc()
                for torrent in plan['torrents']:
                    # Stop redownload/seeding without deleting ANY payload through RPC.
                    # Ambiguous failure aborts before unlink; never retry automatically.
                    rpc.call('torrent_remove', {'ids': [torrent['hash']], 'delete_local_data': False})
            for fd, item in descriptors:
                check_at(fd, item)
            removed = 0
            library = {str(core.media_root() / p): p for p in request['paths']}
            for fd, item in descriptors:
                # Unlink changes nlink/ctime on aliases of this same inode.
                check_at(fd, item, after_unlink=True)
                os.unlink(Path(item['path']).name, dir_fd=fd)
                removed += 1
                path = library.get(item['path'])
                if path is not None:
                    row = next(x for x in inventory['files'] if x['path'] == path)
                    info = state['links'].pop(path, None)
                    identity = row['source_id'] or (info or {}).get('id')
                    if identity and identity not in state['ignored']:
                        state['ignored'].append(identity)
                    # Persist completed library removals even if a later unlink fails.
                    core.save_state(state)
            return {'removed_links': len(request['paths']), 'removed_files': removed,
                    'removed_torrents': len(plan['torrents']), 'mode': request['mode'],
                    'originals_preserved': request['mode'] == 'links'}
    except reconcile.Error as error:
        raise core.MediaError('Armazenamento ocupado ou lock inseguro; tente após a operação atual.') from error


def main():
    if sys.argv[1:] == ['list']:
        inventory = snapshot()
        print(json.dumps({'files': [{k: v for k, v in item.items()
                                     if k in {'path', 'bytes', 'torrent', 'managed', 'eligible'}}
                                    for item in inventory['files']]}, ensure_ascii=False))
        return 0
    if len(sys.argv) < 3 or sys.argv[1] not in {'preview', 'apply'}:
        print('Uso: myct-media-cleanup list|preview TOKEN|apply TOKEN FINGERPRINT', file=sys.stderr)
        return 2
    try:
        request = unpack(sys.argv[2])
        if sys.argv[1] == 'preview' and len(sys.argv) == 3:
            result = preview(request, snapshot())
        elif sys.argv[1] == 'apply' and len(sys.argv) == 4:
            result = apply(request, sys.argv[3])
        else:
            raise core.MediaError('Argumentos inválidos.')
        print(json.dumps(result, ensure_ascii=False))
        return 0
    except (core.MediaError, OSError, KeyError, ValueError, RuntimeError) as e:
        print(str(e) if isinstance(e, core.MediaError) else
              'Falha na consulta/exclusão. Atualize o inventário antes de repetir.', file=sys.stderr)
        return 2

if __name__ == '__main__':
    sys.exit(main())

#!/usr/bin/python3
"""My-CT Media storage cleanup: preview first, explicit confirmation thereafter.

Only verified hardlinks from managed Transmission torrents can be selected.
Deleting original data is whole-torrent-only, delegated to Transmission RPC.
"""
import base64
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import stat
import sys

def load(name):
    path = Path(__file__).with_name(name)
    if not path.is_file() or path.is_symlink():
        raise RuntimeError('Instale ' + name + ' junto com myct-media-cleanup.')
    loader = importlib.machinery.SourceFileLoader('cleanup_' + name.replace('-', '_'), str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module

core = load('myct-media')
MAX_PATHS = 256
MAX_VIDEOS = 2000
TOKEN = re.compile('[A-Za-z0-9_-]{1,48000}')
LIBRARIES = ('Series', 'Series-TV', 'Filmes')


def snapshot(rows=None, state=None):
    """Only paths physically hardlinked to a currently recognized completed torrent."""
    state = state if state is not None else core.load_state()
    rows = rows if rows is not None else core.read_torrents()
    root = core.media_root()
    core.no_symlink_path(root, Path.home())
    source_by_inode = {}
    source_by_hash = {}
    by_hash = {row['hash_string']: row for row in rows}
    for source in core.media_files(rows):
        inode = source['source'].stat()
        source_by_inode.setdefault((inode.st_dev, inode.st_ino), source)
        source_by_hash.setdefault(source['torrent'], []).append(source)
    items = []
    if root.exists():
        for dirname in LIBRARIES:
            base = root / dirname
            if not base.exists():
                continue
            if base.is_symlink() or not base.is_dir():
                raise core.MediaError('Biblioteca redirecionada: ' + dirname)
            # Existing library format: movie/<title>/<video>, tv/<title>/Season NN/<video>
            for folder in sorted(base.iterdir()):
                if folder.is_symlink() or not folder.is_dir():
                    continue
                folders = [folder] if dirname == 'Filmes' else [
                    p for p in sorted(folder.iterdir())
                    if p.is_dir() and not p.is_symlink() and re.fullmatch('Season [0-9]{2}', p.name)
                ]
                for sub in folders:
                    for file in sorted(sub.iterdir()):
                        if not file.is_file() or file.is_symlink() or file.suffix.lower() not in core.VIDEO:
                            continue
                        if len(items) >= MAX_VIDEOS:
                            raise core.MediaError('Biblioteca excede limite de 2000 vídeos.')
                        relative = str(file.relative_to(root))
                        core.safe_relative(relative)
                        inode = file.stat()
                        source = source_by_inode.get((inode.st_dev, inode.st_ino))
                        info = state['links'].get(relative)
                        matched = (source is not None and inode.st_nlink >= 2 and
                                   (info is None or
                                    (info['dev'], info['ino'], info['id']) ==
                                    (inode.st_dev, inode.st_ino, source['id'])))
                        items.append({'path': relative,
                                      'bytes': inode.st_size,
                                      'torrent': source['torrent'] if matched else None,
                                      'source_id': source['id'] if matched else None,
                                      'managed': info is not None,
                                      'eligible': bool(matched),
                                      'dev': inode.st_dev, 'ino': inode.st_ino,
                                      'nlink': inode.st_nlink})
    return {'files': items, 'sources': source_by_hash, 'torrents': by_hash}


def unpack(encoded):
    if not TOKEN.fullmatch(encoded):
        raise core.MediaError('Seleção inválida.')
    try:
        raw = base64.urlsafe_b64decode(encoded + '=' * (-len(encoded) % 4))
        data = json.loads(raw.decode('utf-8'))
    except (UnicodeError, ValueError) as e:
        raise core.MediaError('Seleção inválida.') from e
    if not isinstance(data, dict) or data.get('version') != 1:
        raise core.MediaError('Seleção incompatível.')
    if data.get('mode') not in {'links', 'storage'}:
        raise core.MediaError('Operação de exclusão inválida.')
    paths = data.get('paths')
    if not isinstance(paths, list) or not (1 <= len(paths) <= MAX_PATHS):
        raise core.MediaError('Selecione de 1 a 256 arquivos.')
    if len(paths) != len(set(paths)):
        raise core.MediaError('Há caminhos duplicados.')
    for p in paths:
        if not isinstance(p, str) or len(p) > 4096:
            raise core.MediaError('Caminho inválido.')
        core.safe_relative(p)
    return {'mode': data['mode'], 'paths': sorted(paths)}


def preview(request, inventory):
    lookup = {item['path']: item for item in inventory['files']}
    selection = []
    for path in request['paths']:
        row = lookup.get(path)
        if not row or not row['eligible']:
            raise core.MediaError('Um ou mais arquivos não são hardlinks verificados de torrents My-CT.')
        selection.append(row)
    selected_paths = set(request['paths'])
    grouped = {}
    for item in selection:
        grouped.setdefault(item['torrent'], []).append(item)
    blockers = []
    affected = []
    if request['mode'] == 'storage':
        for key, selected in sorted(grouped.items()):
            all_uses = [f for f in inventory['files'] if f['torrent'] == key]
            outside = [f['path'] for f in all_uses if f['path'] not in selected_paths]
            if outside:
                blockers.append('Torrent ' + key[:12] + ': há ' +
                                str(len(outside)) + ' hardlinks fora da seleção. ' +
                                'Selecione também esses arquivos para excluir o torrent completo.')
            torrent = inventory['torrents'][key]
            if torrent.get('left_until_done') != 0 or torrent.get('error', 0):
                blockers.append('Torrent ' + key[:12] + ' não está concluído/íntegro.')
            files = inventory['sources'].get(key, [])
            represented = {f['source_id'] for f in all_uses}
            selected_inodes = {(f['dev'], f['ino']) for f in selected}
            for original in files:
                st = original['source'].stat()
                related = sum((f['dev'], f['ino']) == (st.st_dev, st.st_ino)
                              for f in all_uses)
                if (st.st_dev, st.st_ino) in selected_inodes and st.st_nlink > related + 1:
                    blockers.append('Torrent ' + key[:12] + ': existem outros hardlinks fora da biblioteca. ' +
                                    'Não é possível garantir a liberação de espaço.')
            unlinked_video = [f['name'] for f in files if f['id'] not in represented]
            affected.append({'hash': key, 'name': torrent.get('name', ''),
                             'videos_outside_library': len(unlinked_video),
                             'examples': unlinked_video[:3],
                             'seeding_will_stop': True})
    material = [(f['path'], f['source_id'], f['dev'], f['ino'], f['nlink'])
                for f in selection]
    material.extend((key, row['download_dir'], row.get('left_until_done'))
                    for key, row in sorted(inventory['torrents'].items())
                    if key in grouped)
    fingerprint = hashlib.sha256(repr((request['mode'], material, blockers, affected)).encode()).hexdigest()
    return {'mode': request['mode'], 'selected': len(selection), 'bytes': sum(f['bytes'] for f in selection),
            'paths': request['paths'], 'torrents': affected, 'blocked': blockers,
            'can_apply': not blockers, 'fingerprint': fingerprint}


def apply(request, expected, rows=None, rpc=None):
    if not re.fullmatch('[0-9a-f]{64}', expected):
        raise core.MediaError('Confirmação inválida.')
    lock_path = core.state_path().with_suffix('.lock')
    lock_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if lock_path.is_symlink():
        raise core.MediaError('Lock inválido.')
    with lock_path.open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = core.load_state()
        inventory = snapshot(rows, state)
        plan = preview(request, inventory)
        if plan['fingerprint'] != expected or not plan['can_apply']:
            raise core.MediaError('A seleção mudou ou existe um bloqueio; refaça a prévia.')
        # Recheck every selected link before touching Transmission.
        for row in (x for x in inventory['files'] if x['path'] in request['paths']):
            file = core.media_root() / core.safe_relative(row['path'])
            core.no_symlink_path(file, core.media_root())
            check = file.stat()
            if (check.st_dev, check.st_ino, check.st_nlink) != (row['dev'], row['ino'], row['nlink']):
                raise core.MediaError('Arquivo mudou durante a confirmação; nova prévia necessária.')
        # No individual original is ever unlinked while a torrent is active.
        if request['mode'] == 'storage':
            if rpc is None:
                torrent_tool = load('myct-torrent')
                rpc = torrent_tool.Rpc()
            for torrent in plan['torrents']:
                # After accepting this RPC, never automatically repeat a failed/ambiguous request.
                rpc.call('torrent_remove', {'ids': [torrent['hash']], 'delete_local_data': True})
        removed = []
        for path in request['paths']:
            row = next(x for x in inventory['files'] if x['path'] == path)
            file = core.media_root() / core.safe_relative(path)
            core.no_symlink_path(file, core.media_root())
            check = file.stat()
            if (check.st_dev, check.st_ino) != (row['dev'], row['ino']):
                raise core.MediaError('Um arquivo mudou durante a exclusão. Atualize o inventário.')
            file.unlink()
            state['links'].pop(path, None)
            if row['source_id'] not in state['ignored']:
                state['ignored'].append(row['source_id'])
            core.save_state(state)
            removed.append(path)
        return {'removed_links': len(removed), 'removed_torrents': len(plan['torrents'])
                if request['mode'] == 'storage' else 0,
                'mode': request['mode'], 'originals_preserved': request['mode'] == 'links'}


def main():
    if sys.argv[1:] == ['list']:
        inventory = snapshot()
        print(json.dumps({'files': [{k: v for k, v in item.items()
                                     if k in {'path', 'bytes', 'torrent', 'managed', 'eligible'}}
                                    for item in inventory['files']]}, ensure_ascii=False))
        return 0
    if len(sys.argv) < 3 or sys.argv[1] not in {'preview', 'apply'}:
        print('Uso: myct-media-cleanup list|preview TOKEN|apply TOKEN FINGERPRINT', file=sys.stderr)
        return 2
    try:
        request = unpack(sys.argv[2])
        if sys.argv[1] == 'preview' and len(sys.argv) == 3:
            result = preview(request, snapshot())
        elif sys.argv[1] == 'apply' and len(sys.argv) == 4:
            result = apply(request, sys.argv[3])
        else:
            raise core.MediaError('Argumentos inválidos.')
        print(json.dumps(result, ensure_ascii=False))
        return 0
    except (core.MediaError, OSError, KeyError, ValueError, RuntimeError) as e:
        print(str(e) if isinstance(e, core.MediaError) else
              'Falha na consulta/exclusão. Atualize o inventário antes de repetir.', file=sys.stderr)
        return 2

if __name__ == '__main__':
    sys.exit(main())

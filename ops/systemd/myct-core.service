[Unit]
Description=My-CT Core - API local de saude do Fedora
Documentation=https://github.com/Samuel-Francisco-AS/My-CT/blob/main/server/README.md
After=local-fs.target

[Service]
Type=simple
User=sam
# Binario implantado em caminho de sistema com contexto SELinux apropriado.
# Nao executar o Core diretamente do checkout em /home.
ExecStart=/usr/local/bin/myct-core
Restart=on-failure
RestartSec=3s
# Nao entrar em loop se o systemd nao conseguir executar o binario.
RestartPreventExitStatus=203
NoNewPrivileges=yes
LimitCORE=0
UMask=0077

[Install]
WantedBy=multi-user.target

#!/usr/bin/python3
"""Explicit manual batch organizer for completed My-CT Transmission media.

Companion to myct-media. All data sources are read from the existing managed
Transmission RPC adapter. No arbitrary filesystem paths are accepted from Android.
"""
import base64
import fcntl
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys

CORE_PATH = Path(__file__).with_name('myct-media')
if not CORE_PATH.is_file() or CORE_PATH.is_symlink():
    raise SystemExit('Instale myct-media junto com myct-media-bulk.')
_loader = importlib.machinery.SourceFileLoader('myct_media_core_batch', str(CORE_PATH))
_spec = importlib.util.spec_from_loader(_loader.name, _loader)
core = importlib.util.module_from_spec(_spec)
_loader.exec_module(core)

MAX_SELECTED = 128
MAX_AVAILABLE = 400
TOKEN = re.compile(r'[A-Za-z0-9_-]{1,48000}')
HASH_ID = re.compile(r'[0-9a-f]{40}:.{1,4096}', re.S)


def sources(rows):
    found = list(core.media_files(rows))
    if len(found) > MAX_AVAILABLE:
        raise core.MediaError('Mais de 400 vídeos concluídos; reduza o número de torrents antes de consultar.')
    return {'files': [{'id': item['id'], 'torrent': item['torrent'],
                       'name': item['name'], 'path': item['id'].split(':', 1)[1]}
                      for item in found]}


def manifest(encoded):
    if not TOKEN.fullmatch(encoded):
        raise core.MediaError('Seleção inválida.')
    try:
        binary = base64.urlsafe_b64decode(encoded + '=' * (-len(encoded) % 4))
        value = json.loads(binary.decode('utf-8'))
    except (ValueError, UnicodeError) as exc:
        raise core.MediaError('Seleção inválida.') from exc
    if not isinstance(value, dict) or value.get('version') != 1:
        raise core.MediaError('Versão da seleção inválida.')
    kind = value.get('kind')
    if kind not in {'anime', 'series', 'movie'}:
        raise core.MediaError('Escolha anime, série ou filme.')
    title = core.title_clean(value.get('title', ''))
    selected = value.get('files')
    if not isinstance(selected, list) or not (1 <= len(selected) <= MAX_SELECTED):
        raise core.MediaError('Selecione de 1 a 128 vídeos.')
    if kind == 'movie' and len(selected) != 1:
        raise core.MediaError('Filme aceita um vídeo por importação; selecione outro filme separadamente.')
    if kind == 'movie':
        year = value.get('year')
        if type(year) is not int or not 1900 <= year <= 2100:
            raise core.MediaError('Informe o ano do filme.')
        season = None
    else:
        season = value.get('season')
        if type(season) is not int or not 0 <= season <= 99:
            raise core.MediaError('Informe temporada entre 0 e 99.')
        year = None
    ids, episodes = set(), set()
    normalized = []
    for item in selected:
        if not isinstance(item, dict):
            raise core.MediaError('Item selecionado inválido.')
        key = item.get('id')
        if not isinstance(key, str) or not HASH_ID.fullmatch(key) or key in ids:
            raise core.MediaError('Arquivo duplicado ou identificador inválido.')
        ids.add(key)
        if kind != 'movie':
            episode = item.get('episode')
            if type(episode) is not int or not 1 <= episode <= 999 or episode in episodes:
                raise core.MediaError('Episódios devem ter números únicos entre 1 e 999.')
            episodes.add(episode)
        else:
            episode = None
        normalized.append({'id': key, 'episode': episode})
    return {'kind': kind, 'title': title, 'season': season, 'year': year, 'files': normalized}


def target_for(item, spec, episode):
    root = core.media_root()
    if spec['kind'] == 'movie':
        result = core.destination(root, item, {'kind': 'movie', 'title': spec['title'], 'year': spec['year']})
    else:
        result = core.destination(root, item, {'kind': 'series', 'title': spec['title'],
                                               'season': spec['season'], 'episode': episode})
        if spec['kind'] == 'series':
            # The installed Jellyfin "Animes" library points to Media/Series.
            # Ordinary TV gets its own root; users must configure that library separately.
            title = spec['title']
            result = Path('Series-TV') / title / result.parts[-2] / result.name
    core.safe_relative(result)
    return result


def plan(spec, rows, state):
    found = {item['id']: item for item in core.media_files(rows)}
    if len(found) > MAX_AVAILABLE:
        raise core.MediaError('Mais de 400 vídeos; reduza os torrents.')
    root = core.media_root()
    used = set()
    items = []
    for selection in spec['files']:
        key = selection['id']
        candidate = found.get(key)
        if candidate is None:
            raise core.MediaError('Vídeo não está mais disponível ou torrent ainda não concluiu.')
        relative = target_for(candidate, spec, selection['episode'])
        path = root / relative
        core.no_symlink_path(path.parent, root)
        if str(relative) in used:
            status = 'collision'
        elif path.exists() or path.is_symlink():
            orig, dest = candidate['source'].stat(), path.stat()
            status = 'existing' if (orig.st_dev, orig.st_ino) == (dest.st_dev, dest.st_ino) else 'collision'
        elif str(relative) in state['links']:
            # A managed target was removed externally; manual recovery is deliberate.
            status = 'collision'
        else:
            status = 'ready'
        used.add(str(relative))
        items.append({'id': key, 'name': candidate['name'], 'target': str(relative),
                      'episode': selection['episode'], 'status': status})
    return {'kind': spec['kind'], 'items': items,
            'ready': sum(x['status'] == 'ready' for x in items),
            'existing': sum(x['status'] == 'existing' for x in items),
            'collisions': sum(x['status'] == 'collision' for x in items)}


def run(argv, rows=None, acl=None):
    if not argv or argv[0] not in {'sources', 'plan', 'import'}:
        raise core.MediaError('Uso: myct-media-bulk sources|plan TOKEN|import TOKEN')
    if (argv[0] == 'sources' and len(argv) != 1) or (argv[0] != 'sources' and len(argv) != 2):
        raise core.MediaError('Argumentos inválidos.')
    lock_path = core.state_path().with_suffix('.lock')
    lock_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if lock_path.is_symlink():
        raise core.MediaError('Lock inválido.')
    with lock_path.open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = rows if rows is not None else core.read_torrents()
        if argv[0] == 'sources':
            return sources(data)
        spec = manifest(argv[1])
        state = core.load_state()
        preview = plan(spec, data, state)
        if argv[0] == 'plan':
            return preview
        if preview['collisions']:
            raise core.MediaError('Há destinos ocupados ou repetidos. Desmarque/corrija antes de importar.')
        candidates = {item['id']: item for item in core.media_files(data)}
        results = []
        access = acl or core.ensure_access
        for item in preview['items']:
            if item['status'] == 'existing':
                results.append({'id': item['id'], 'target': item['target'], 'status': 'existing'})
                continue
            candidate = candidates[item['id']]
            relative = core.safe_relative(item['target'])
            outcome = core.add_one(candidate, relative, state, acl=access)
            if outcome == 'added':
                if item['id'] in state['ignored']:
                    state['ignored'].remove(item['id'])
                core.save_state(state)  # journal each successful link before the next operation
            results.append({'id': item['id'], 'target': item['target'], 'status': outcome})
        return {'items': results, 'added': sum(x['status'] == 'added' for x in results),
                'existing': sum(x['status'] == 'existing' for x in results),
                'originals_preserved': True}


def main():
    os.umask(0o077)
    try:
        print(json.dumps(run(sys.argv[1:]), ensure_ascii=False))
        return 0
    except (core.MediaError, ValueError, KeyError, OSError, TypeError, subprocess.CalledProcessError) as exc:
        print(str(exc) if isinstance(exc, core.MediaError) else 'Falha ao consultar ou importar mídia.', file=sys.stderr)
        return 2

if __name__ == '__main__':
    sys.exit(main())

#!/usr/bin/python3
"""My-CT Media: conservative Transmission -> Jellyfin hardlink importer.

No torrent files are moved/renamed/deleted, and there are no external dependencies
besides the existing myct-torrent adapter and setfacl on Fedora.
"""
import fcntl
import copy
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import stat
import struct
import subprocess
import sys
import unicodedata

LIMIT = 2000
VIDEO = {'.mkv', '.mp4', '.avi', '.webm', '.m4v'}
SERIES = re.compile(r'^(.+?)[. _-]+S(\d{1,2})E(\d{1,3})(?![0-9A-Za-z])', re.I)
MOVIE = re.compile(r'^(.+?)[. _-]+(19\d{2}|20\d{2})[. _-]+(?:480p|720p|1080p|2160p|4k|web|bluray|bdrip|dvdrip)(?![a-z])', re.I)
UNWANTED = re.compile(r'(?:^|[\W_])(sample|trailer|preview|promo|advert|1xbet|xbet)(?:$|[\W_])', re.I)
# Fansub episode numbering is ambiguous without a known title mapping: keep unknowns pending.
FANSUB = re.compile(r'^\[[A-Za-z0-9 ._-]{1,24}\]\s*(.+?)\s+-\s+(\d{1,3})\s+\[(?:480|720|1080|2160)p\](?:\[|$)', re.I)
SERIES_ALIASES = {'sousou no frieren': ('Frieren Beyond Journeys End', 1)}
# Bare trailing episode numbers are trusted only for explicitly identified shows.
PLAIN_EPISODE = re.compile(r'^(.+?)\s+(\d{1,3})$')
PLAIN_SERIES = {'fullmetal alchemist brotherhood': ('Fullmetal Alchemist Brotherhood', 1, 64)}

class MediaError(Exception):
    pass

def title_clean(value):
    value = unicodedata.normalize('NFC', value.replace('.', ' ').replace('_', ' '))
    value = re.sub(r'\s+', ' ', value).strip(' .-_')
    if not value or len(value) > 100 or value.startswith('.') or '/' in value or '\\' in value:
        raise MediaError('Título inválido.')
    if any(unicodedata.category(c).startswith('C') for c in value):
        raise MediaError('Título inválido.')
    return value

def media_root():
    return Path.home() / 'Media'

def state_path():
    return Path.home() / '.local/share/myct/media/state.json'

def load_state():
    path = state_path()
    if path.is_symlink():
        raise MediaError('Estado da biblioteca não pode ser link simbólico.')
    if not path.exists():
        return {'links': {}, 'ignored': []}
    value = json.loads(path.read_text())
    if not isinstance(value, dict) or not isinstance(value.get('links'), dict) or not isinstance(value.get('ignored'), list):
        raise MediaError('Estado local inválido.')
    return value

def save_state(data):
    path = state_path()
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temp = path.with_suffix('.tmp')
    if temp.is_symlink():
        raise MediaError('Arquivo temporário de estado inválido.')
    try:
        with temp.open('w') as fp:
            os.fchmod(fp.fileno(), 0o600)
            json.dump(data, fp, ensure_ascii=False, sort_keys=True)
            fp.flush()
            os.fsync(fp.fileno())
        os.replace(temp, path)
    finally:
        temp.unlink(missing_ok=True)

def no_symlink_path(path, stop):
    """Check every existing component down to an expected, trusted parent."""
    current = path
    while True:
        try:
            if stat.S_ISLNK(current.lstat().st_mode):
                raise MediaError('Link simbólico encontrado no caminho: ' + str(current))
        except FileNotFoundError:
            pass
        if current == stop:
            break
        if current == current.parent:
            raise MediaError('Caminho fora da raiz.')
        current = current.parent

def safe_relative(relative):
    candidate = Path(relative)
    if candidate.is_absolute() or not candidate.parts or any(p in {'.', '..', ''} for p in candidate.parts):
        raise MediaError('Caminho de biblioteca inválido.')
    if len(candidate.parts) < 3 or candidate.parts[0] not in {'Series', 'Series-TV', 'Filmes'}:
        raise MediaError('Caminho fora da biblioteca.')
    return candidate

def read_torrents(include_files=False, rows=None):
    cli = Path.home() / '.local/bin/myct-torrent'
    if not cli.is_file() or cli.is_symlink():
        raise MediaError('Instale primeiro ~/.local/bin/myct-torrent.')
    loader = importlib.machinery.SourceFileLoader('myct_torrent_for_media', str(cli))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    # A read-only preview must not create __pycache__ beside installed helpers.
    exec(compile(cli.read_bytes(), str(cli), 'exec'), module.__dict__)
    if include_files:
        module.FIELDS = module.FIELDS + ['files']
    class SnapshotRpc:
        def call(self, method, params):
            assert method == 'torrent_get'
            return {'torrents': rows}
    return module.records(module.Rpc() if rows is None else SnapshotRpc())


def filesystem_identity(path):
    """Read-only Btrfs UUID + subvolume id, never an ephemeral st_dev anchor.

    Unsupported/unavailable identity is explicit: such files cannot be reanchored.
    Linux UAPI btrfs.h: FS_INFO (1024 bytes), INO_LOOKUP (4096 bytes, root inode 256).
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        fs = bytearray(1024)
        fcntl.ioctl(fd, 0x8400941f, fs)
        lookup = bytearray(4096)
        struct.pack_into('=QQ', lookup, 0, 0, 256)
        fcntl.ioctl(fd, 0xd0009412, lookup)
        uuid = bytes(fs[16:32]).hex()
        subvolume = struct.unpack_from('=Q', lookup)[0]
        return {'kind': 'btrfs', 'uuid': uuid, 'subvolume': subvolume} if uuid != '0' * 32 and subvolume > 0 else None
    except OSError:
        return None
    finally:
        os.close(fd)


def link_record(identity, path):
    s = path.stat()
    return {'id': identity, 'dev': s.st_dev, 'ino': s.st_ino,
            'metadata': {'size': s.st_size, 'mtime_ns': s.st_mtime_ns, 'uid': s.st_uid},
            'filesystem': filesystem_identity(path)}


def record_matches(info, identity, path, source=None):
    """Recognize a current hardlink; st_dev is not a persistent filesystem ID.

    A supplied source must be the caller's trusted path for this exact torrent ID.
    Without a current source use the saved filesystem identity when available;
    unanchored legacy records retain the strict fallback for absent originals. Neither branch writes/adopts a record or reads video content.
    """
    if not isinstance(info, dict) or info.get('id') != identity:
        return False
    no_symlink_path(path, Path.home())
    s = path.lstat()
    if not stat.S_ISREG(s.st_mode) or info.get('ino') != s.st_ino:
        return False
    fs = None
    if source is not None:
        no_symlink_path(source, Path.home())
        original = source.lstat()
        if not stat.S_ISREG(original.st_mode) or (original.st_dev, original.st_ino) != (s.st_dev, s.st_ino):
            return False
        if info.get('dev') != s.st_dev or info.get('filesystem'):
            fs = filesystem_identity(path)
            if fs is None or fs != filesystem_identity(source):
                return False
    elif not info.get('filesystem') and info.get('dev') != s.st_dev:
        # No source and no persistent identity: historical inode alone is insufficient.
        return False
    if 'metadata' in info and info['metadata'] != {
            'size': s.st_size, 'mtime_ns': s.st_mtime_ns, 'uid': s.st_uid}:
        return False
    return not info.get('filesystem') or info['filesystem'] == (fs or filesystem_identity(path))


def reconciliation_plan(rows=None, state=None):
    """No writes/locks/hash reads. Propose metadata reanchoring; never authorize deletion.

    v1 has no historical UUID/size/mtime. Its candidates are explicitly marked as
    legacy re-registration, NOT proof that the historical filesystem is unchanged.
    Only the expected, currently recognized torrent source can supply that trust.
    """
    state = load_state() if state is None else state
    rows = read_torrents(include_files=True, rows=rows)
    sources, source_inodes = {}, {}
    for candidate in media_files(rows):
        sources.setdefault(candidate['id'], []).append(candidate)
        s = candidate['source'].stat()
        source_inodes.setdefault((s.st_dev, s.st_ino), []).append(candidate)
    by_hash = {}
    for row in rows:
        by_hash.setdefault(row['hash_string'], []).append(row)
    entries = []
    # Includes absent records: never drop them or silently adopt unrecorded links.
    known = {}
    for rel in state['links']:
        try:
            p = media_root() / safe_relative(rel)
            no_symlink_path(p, Path.home())
            s = p.lstat()
            if stat.S_ISREG(s.st_mode):
                known.setdefault((s.st_dev, s.st_ino), []).append(rel)
        except (MediaError, OSError):
            pass
    for rel, info in sorted(state['links'].items()):
        item = {'path': rel, 'eligible': False, 'reason': 'UNPROVEN'}
        entries.append(item)
        try:
            dest = media_root() / safe_relative(rel)
            no_symlink_path(dest, Path.home())
            d = dest.lstat()
            if not stat.S_ISREG(d.st_mode) or d.st_uid != os.getuid():
                raise MediaError('UNSAFE_PATH')
            if not isinstance(info, dict) or type(info.get('dev')) is not int or type(info.get('ino')) is not int:
                raise MediaError('INVALID_RECORD')
            identity = info.get('id', '')
            if identity in state['ignored']:
                raise MediaError('IGNORED')
            candidates = sources.get(identity, [])
            if len(candidates) != 1:
                raise MediaError('SOURCE_ABSENT_OR_AMBIGUOUS')
            source = candidates[0]['source']
            no_symlink_path(source, Path.home())
            s = source.lstat()
            if not stat.S_ISREG(s.st_mode) or s.st_uid != os.getuid():
                raise MediaError('UNSAFE_SOURCE')
            if (s.st_dev, s.st_ino) != (d.st_dev, d.st_ino):
                raise MediaError('SOURCE_INODE_MISMATCH')
            if info.get('ino') != d.st_ino:
                raise MediaError('RECORDED_INODE_MISMATCH')
            torrent_rows = by_hash[candidates[0]['torrent']]
            if len(torrent_rows) != 1:
                raise MediaError('AMBIGUOUS_TORRENT')
            row = torrent_rows[0]
            relative_source = str(source.relative_to(Path(row['download_dir'])))
            expected = [f for f in row.get('files', []) if f.get('name') == relative_source]
            if len(expected) != 1 or expected[0].get('length') != d.st_size or not d.st_size:
                raise MediaError('TORRENT_METADATA_MISMATCH')
            # One expected source plus all recorded library aliases; no unknown links.
            aliases = known[(d.st_dev, d.st_ino)]
            if any(not isinstance(state['links'][p], dict) or state['links'][p].get('id') != identity for p in aliases):
                raise MediaError('AMBIGUOUS_LIBRARY')
            if d.st_nlink != 1 + len(aliases):
                raise MediaError('UNKNOWN_LINKS')
            source_aliases = source_inodes[(d.st_dev, d.st_ino)]
            if len(source_aliases) != 1:
                raise MediaError('AMBIGUOUS_SOURCE')
            current = link_record(identity, dest)
            if current['filesystem'] is None or current['filesystem'] != filesystem_identity(source):
                raise MediaError('FILESYSTEM_UNPROVEN')
            if info.get('filesystem') and info['filesystem'] != current['filesystem']:
                raise MediaError('FILESYSTEM_CHANGED')
            if 'metadata' in info and info['metadata'] != current['metadata']:
                raise MediaError('RECORDED_METADATA_MISMATCH')
            fields = ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns', 'st_nlink', 'st_uid', 'st_mode')
            if (any(getattr(source.lstat(), k) != getattr(s, k) for k in fields) or
                    any(getattr(dest.lstat(), k) != getattr(d, k) for k in fields) or
                    (current['dev'], current['ino']) != (d.st_dev, d.st_ino)):
                raise MediaError('CHANGED_DURING_PLAN')
            item.update(before=copy.deepcopy(info), after=current,
                        evidence={'source': str(source), 'source_stat': {
                            'dev': s.st_dev, 'ino': s.st_ino, 'size': s.st_size,
                            'mtime_ns': s.st_mtime_ns, 'ctime_ns': s.st_ctime_ns,
                            'nlink': s.st_nlink, 'uid': s.st_uid},
                            'library_ctime_ns': d.st_ctime_ns, 'aliases': sorted(aliases),
                            'expected_length': expected[0]['length']})
            if info.get('dev') == d.st_dev and record_matches(info, identity, dest, source):
                item['reason'] = 'CURRENT'
            else:
                item['reason'] = 'LEGACY_REANCHOR' if not info.get('filesystem') else 'DEVICE_REANCHOR'
                item['eligible'] = True
        except FileNotFoundError:
            item['reason'] = 'ABSENT'
        except MediaError as error:
            item['reason'] = str(error)
        except (OSError, ValueError, KeyError, TypeError):
            item['reason'] = 'UNSAFE_OR_INVALID'
    plan = {'version': 1, 'application_supported': False,
            'state_sha256': hashlib.sha256(json.dumps(state, sort_keys=True).encode()).hexdigest(),
            'entries': entries, 'eligible': sum(x['eligible'] for x in entries),
            'legacy_requires_explicit_reanchor': any(x['eligible'] and x['reason'] == 'LEGACY_REANCHOR' for x in entries)}
    plan['fingerprint'] = hashlib.sha256(json.dumps(plan, sort_keys=True).encode()).hexdigest()
    return plan


def reconciled_state(state, plan, fresh, confirmation, accept_legacy=False):
    """Pure transformation; only myct_media_reconcile may persist its proposal.

    This function does not implement or substitute transaction/backup/lock duties.
    """
    digest = hashlib.sha256(json.dumps({k: v for k, v in fresh.items() if k != 'fingerprint'}, sort_keys=True).encode()).hexdigest()
    if plan != fresh or confirmation != digest or digest != fresh['fingerprint']:
        raise MediaError('Plano de reconciliação mudou; gere nova prévia.')
    if hashlib.sha256(json.dumps(state, sort_keys=True).encode()).hexdigest() != fresh['state_sha256']:
        raise MediaError('Índice mudou; gere nova prévia.')
    if fresh['legacy_requires_explicit_reanchor'] and not accept_legacy:
        raise MediaError('Legado sem identidade histórica de filesystem exige reancoramento explícito.')
    result = copy.deepcopy(state)
    for entry in fresh['entries']:
        if entry['eligible']:
            result['links'][entry['path']] = copy.deepcopy(entry['after'])
    return result

def media_files(rows, download_root=None, include_incomplete=False):
    root = download_root or Path.home() / 'Downloads/My-CT/Torrents'
    no_symlink_path(root, Path.home())
    count = 0
    for row in rows:
        if not include_incomplete and (row.get('left_until_done') != 0 or row.get('metadata_percent_complete') != 1 or row.get('error', 0)):
            continue
        key = row.get('hash_string', '')
        if not isinstance(key, str) or not re.fullmatch(r'[0-9a-f]{40}', key):
            continue
        base = Path(row.get('download_dir', ''))
        if base.parent != root or base.is_symlink() or not base.is_dir():
            continue
        for dirpath, dirs, files in os.walk(base, followlinks=False):
            dirs[:] = sorted(d for d in dirs if not (Path(dirpath) / d).is_symlink())
            for filename in sorted(files):
                source = Path(dirpath) / filename
                if source.suffix.lower() not in VIDEO or source.is_symlink() or not source.is_file():
                    continue
                count += 1
                if count > LIMIT:
                    raise MediaError('Mais de 2000 vídeos; reduza o lote de importação.')
                yield {'id': key + ':' + str(source.relative_to(base)), 'source': source,
                       'torrent': key, 'name': filename}

def classify(name):
    stem = Path(name).stem
    if UNWANTED.search(stem):
        return None
    episode = SERIES.match(stem)
    if episode:
        name = title_clean(episode.group(1))
        return {'kind': 'series', 'title': name, 'season': int(episode.group(2)), 'episode': int(episode.group(3))}
    fansub = FANSUB.match(stem)
    if fansub:
        alias = SERIES_ALIASES.get(title_clean(fansub.group(1)).casefold())
        number = int(fansub.group(2))
        if alias and 1 <= number <= 999:
            title, season = alias
            return {'kind': 'series', 'title': title, 'season': season, 'episode': number}
    bare = PLAIN_EPISODE.fullmatch(stem)
    if bare:
        known = PLAIN_SERIES.get(title_clean(bare.group(1)).casefold())
        number = int(bare.group(2))
        if known and 1 <= number <= known[2]:
            title, season, _ = known
            return {'kind': 'series', 'title': title, 'season': season, 'episode': number}
    film = MOVIE.match(stem)
    if film:
        return {'kind': 'movie', 'title': title_clean(film.group(1)), 'year': int(film.group(2))}
    return None

def series_folder(root, title):
    parent = root / 'Series'
    if not parent.exists():
        return title
    wanted = title.casefold()
    candidates = [p.name for p in parent.iterdir() if p.is_dir() and not p.is_symlink()
                  and re.sub(r' \(\d{4}\)$', '', p.name).casefold() == wanted]
    if len(candidates) > 1:
        raise MediaError('Duas séries com o mesmo nome; confirme manualmente.')
    return candidates[0] if candidates else title

def destination(root, candidate, spec):
    title = title_clean(spec['title'])
    extension = candidate['source'].suffix.lower()
    if spec['kind'] == 'series':
        season, episode = spec['season'], spec['episode']
        if not 0 <= season <= 99 or not 1 <= episode <= 999:
            raise MediaError('Temporada/episódio fora do intervalo.')
        folder = series_folder(root, title)
        return Path('Series') / folder / f'Season {season:02d}' / f'{title} S{season:02d}E{episode:02d}{extension}'
    if spec['kind'] == 'movie':
        year = spec['year']
        if not 1900 <= year <= 2100:
            raise MediaError('Ano fora do intervalo.')
        return Path('Filmes') / f'{title} ({year})' / f'{title} ({year}){extension}'
    raise MediaError('Tipo de mídia inválido.')

def ensure_access(file, root):
    if shutil.which('setfacl') is None:
        raise MediaError('Instale o pacote acl para conceder leitura ao Jellyfin.')
    # The owner grants traversal only to the media tree; /home/sam itself requires
    # the one-time administrator ACL documented in MYCT-MEDIA.md.
    current = file.parent
    while current != root.parent:
        subprocess.run(['setfacl', '-m', 'u:jellyfin:r-x', str(current)], check=True,
                       stdout=subprocess.DEVNULL)
        if current == root:
            break
        current = current.parent
    subprocess.run(['setfacl', '-m', 'u:jellyfin:r--', str(file)], check=True,
                   stdout=subprocess.DEVNULL)

def add_one(candidate, relative, state, acl=ensure_access):
    root = media_root()
    relative = safe_relative(str(relative))
    source = candidate['source']
    if source.is_symlink() or not source.is_file() or not source.stat().st_size:
        raise MediaError('Fonte não é arquivo regular concluído.')
    dest = root / relative
    no_symlink_path(dest.parent, root)
    if dest.exists() or dest.is_symlink():
        s = source.stat(); d = dest.stat()
        if (s.st_dev, s.st_ino) == (d.st_dev, d.st_ino):
            return 'existing'
        raise MediaError('Destino já existe com conteúdo diferente: ' + str(relative))
    dest.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    no_symlink_path(dest.parent, root)
    os.link(source, dest, follow_symlinks=False)
    try:
        acl(dest, root)
        s = source.stat(); d = dest.stat()
        if (s.st_dev, s.st_ino) != (d.st_dev, d.st_ino):
            raise MediaError('Hardlink inválido após criação.')
    except Exception:
        dest.unlink(missing_ok=True)  # only the just-created library link
        raise
    state['links'][str(relative)] = link_record(candidate['id'], dest)
    return 'added'

def inspect(rows, state, apply=False, override=None, acl=ensure_access):
    root = media_root()
    result = {'added': [], 'existing': [], 'pending': [], 'ignored': 0}
    ids = set()
    previously_imported = {item.get('id') for item in state['links'].values()}
    for candidate in media_files(rows):
        key = candidate['id']
        if key in ids:
            continue
        ids.add(key)
        if key in state['ignored']:
            result['ignored'] += 1
            continue
        if key in previously_imported:
            registered = [(rel, info) for rel, info in state['links'].items() if info.get('id') == key]
            try:
                valid = True
                for rel, info in registered:
                    target = root / safe_relative(rel)
                    no_symlink_path(target, Path.home())
                    a, b = candidate['source'].stat(), target.stat()
                    valid = valid and (a.st_dev, a.st_ino) == (b.st_dev, b.st_ino) and record_matches(info, key, target, candidate['source'])
            except (MediaError, OSError, ValueError, KeyError, TypeError):
                valid = False
            if valid:
                result['existing'].append({'id': key, 'managed': True})
            else:
                result['pending'].append({'id': key, 'reason': 'Origem ou registro Media divergente; revise a procedência. Exclusão local continua disponível em Armazenamento.', 'name': candidate['name']})
            continue
        try:
            spec = override[key] if override and key in override else classify(candidate['name'])
            if not spec:
                result['pending'].append({'id': key, 'reason': 'não reconhecido', 'name': candidate['name']})
                continue
            relative = destination(root, candidate, spec)
            if not apply:
                target = root / relative
                no_symlink_path(target.parent, root)
                if target.exists() or target.is_symlink():
                    source_info = candidate['source'].stat()
                    dest_info = target.stat()
                    if (source_info.st_dev, source_info.st_ino) == (dest_info.st_dev, dest_info.st_ino):
                        result['existing'].append({'id': key, 'target': str(relative)})
                    else:
                        raise MediaError('Destino já existe com conteúdo diferente: ' + str(relative))
                else:
                    result['added'].append({'id': key, 'target': str(relative), 'preview': True})
                continue
            outcome = add_one(candidate, relative, state, acl=acl)
            result[outcome].append({'id': key, 'target': str(relative)})
        except (MediaError, OSError, subprocess.CalledProcessError) as error:
            result['pending'].append({'id': key, 'name': candidate['name'], 'reason': str(error)})
    return result

def remove_one(relative, state):
    relative = safe_relative(relative)
    info = state['links'].get(str(relative))
    if info is None:
        raise MediaError('Arquivo não foi criado pelo My-CT Media; remoção recusada.')
    dest = media_root() / relative
    no_symlink_path(dest, media_root())
    st = dest.stat()
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
        raise MediaError('O alvo não é arquivo regular do proprietário.')
    dest.unlink()  # original torrent remains untouched
    state['links'].pop(str(relative))
    if info['id'] not in state['ignored']:
        state['ignored'].append(info['id'])  # timer must never recreate after explicit removal

def run(argv, rows=None, acl=ensure_access):
    if argv == ['reconcile-plan']:
        return reconciliation_plan(rows=rows)
    if argv and argv[0] in {'reconcile-preview', 'reconcile-apply', 'reconcile-recover'}:
        source = Path(__file__).with_name('myct_media_reconcile.py')
        if source.is_symlink() or not source.is_file():
            raise MediaError('Instale o módulo auditado myct_media_reconcile.py junto do helper.')
        spec = importlib.util.spec_from_file_location('myct_media_transaction', source)
        module = importlib.util.module_from_spec(spec)
        exec(compile(source.read_bytes(), str(source), 'exec'), module.__dict__)
        return module.run(sys.modules[__name__] if __name__ in sys.modules else _module_view(), argv)
    if not argv or argv[0] not in {'scan', 'sync', 'list', 'approve', 'skip', 'remove'}:
        raise MediaError('Uso: myct-media reconcile-plan|scan|sync|list|skip ID|remove RELPATH|approve ID series TITULO TEMP EP|approve ID movie TITULO ANO')
    action = argv[0]
    lock_path = state_path().with_suffix('.lock')
    lock_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if lock_path.is_symlink():
        raise MediaError('Lock inválido.')
    with lock_path.open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = load_state()
        if action == 'list' and len(argv) == 1:
            return {'links': state['links'], 'ignored': state['ignored']}
        if action == 'remove' and len(argv) == 2:
            remove_one(argv[1], state)
            save_state(state)
            return {'removed': argv[1], 'original_preserved': True}
        if action == 'skip' and len(argv) == 2:
            if not re.fullmatch(r'[0-9a-f]{40}:.{1,1024}', argv[1]):
                raise MediaError('Identificador inválido.')
            if argv[1] not in state['ignored']:
                state['ignored'].append(argv[1])
            save_state(state)
            return {'ignored': argv[1]}
        if action == 'approve':
            if len(argv) == 6 and argv[2] == 'series':
                spec = {'kind':'series', 'title':argv[3], 'season':int(argv[4]), 'episode':int(argv[5])}
            elif len(argv) == 5 and argv[2] == 'movie':
                spec = {'kind':'movie', 'title':argv[3], 'year':int(argv[4])}
            else:
                raise MediaError('Uso: approve ID series TITULO TEMP EP | approve ID movie TITULO ANO')
            candidates = list(media_files(rows if rows is not None else read_torrents()))
            matching = [c for c in candidates if c['id'] == argv[1]]
            if len(matching) != 1:
                raise MediaError('Arquivo não encontrado entre torrents concluídos.')
            relative = destination(media_root(), matching[0], spec)
            result = add_one(matching[0], relative, state, acl=acl)
            if result == 'added':
                save_state(state)
            return {result: str(relative)}
        if action not in {'scan','sync'} or len(argv) != 1:
            raise MediaError('Argumentos inválidos.')
        report = inspect(rows if rows is not None else read_torrents(), state, apply=(action == 'sync'), acl=acl)
        if action == 'sync':
            save_state(state)
        return report

def _module_view():
    # SourceFileLoader callers may not register their module in sys.modules.
    from types import SimpleNamespace
    return SimpleNamespace(**globals())

def main():
    os.umask(0o077)
    try:
        output = run(sys.argv[1:])
        print(json.dumps(output, ensure_ascii=False))
    except (MediaError, OSError, ValueError, KeyError, json.JSONDecodeError, subprocess.CalledProcessError) as e:
        print(str(e) if isinstance(e, MediaError) else 'Erro ao acessar arquivos, ACL ou Transmission.', file=sys.stderr)
        return 2
    return 0

if __name__ == '__main__':
    sys.exit(main())

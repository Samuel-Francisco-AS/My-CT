#!/usr/bin/python3
"""C1C SSH bridge: fixed archive CLI work in transient user units, no daemon.

Catalogs and destructive consent remain exclusively in the existing engines.
The small private journal records delivery/results, never authorizes a retry.
"""
import base64
from contextlib import contextmanager
import fcntl
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import tempfile
import time

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
from myct_cloud_progress import Progress, read_progress
ROOT = Path.home() / '.local/share/myct/cloud-jobs'
ACTIVE = {'starting', 'running', 'cancelling', 'uncertain'}
ID = re.compile('[0-9a-f]{32}')
ARCHIVE = re.compile('[0-9a-f]{64}')
TOKEN = re.compile('[0-9]{1,12}-[0-9a-f]{64}')
LIMIT = 16 * 1024 * 1024


class Failure(Exception):
    def __init__(self, code, message):
        self.code = code
        super().__init__(message)


def need(ok, code='ARGUMENT', message='Pedido inválido.'):
    if not ok:
        raise Failure(code, message)


def private_root():
    ROOT.mkdir(parents=True, mode=0o700, exist_ok=True)
    need(not ROOT.is_symlink() and ROOT.resolve() == ROOT and
         ROOT.stat().st_uid == os.getuid() and ROOT.stat().st_mode & 0o077 == 0,
         'PERMISSIONS', 'O diário deve ser privado (0700) e pertencer ao usuário.')


def load(identity):
    need(ID.fullmatch(identity))
    path = ROOT / (identity + '.json')
    need(not path.is_symlink(), 'JOURNAL', 'Diário redirecionado; confira manualmente.')
    info = path.lstat()
    need(stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid() and
         not info.st_mode & 0o077 and info.st_nlink == 1, 'PERMISSIONS', 'Recibo deve ser privado e pertencer ao usuário.')
    return json.loads(path.read_text())


def save(row):
    with tempfile.NamedTemporaryFile('w', dir=ROOT, delete=False) as stream:
        json.dump(row, stream, ensure_ascii=True)
        stream.flush(); os.fsync(stream.fileno())
    os.replace(stream.name, ROOT / (row['id'] + '.json'))
    fd = os.open(ROOT, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


@contextmanager
def locked():
    fd = os.open(ROOT / 'delivery.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def validate(work):
    need(isinstance(work, dict) and set(work) == {'kind', 'args'})
    kind, args = work['kind'], work['args']
    need(kind in ('torrent', 'file') and isinstance(args, list) and 1 <= len(args) <= 520)
    need(all(isinstance(a, str) and 0 < len(a.encode()) <= 4096 and
             not any(ord(c) < 32 or ord(c) == 127 for c in a) for a in args))
    action = args[0]
    if kind == 'file':
        need((action == 'status' and len(args) == 1) or
             (action in ('archive', 'restore') and len(args) == 2))
        if action == 'archive':
            need(args[1].startswith('/') and all(p not in ('.', '..') for p in args[1].split('/')))
        elif action == 'restore':
            need(ARCHIVE.fullmatch(args[1]))
        return work
    need(action in ('inspect', 'archive', 'space', 'release', 'restore', 'recover', 'relink') and len(args) >= 2)
    need(re.fullmatch('[0-9a-f]{40}', args[1]) if action in ('inspect', 'archive') else ARCHIVE.fullmatch(args[1]))
    if action in ('inspect', 'archive', 'restore'):
        need(len(args) == 2)
    elif action == 'recover':
        need(args[2:] in ([], ['--resume']))
    else:
        rest, options, paths = args[2:], {}, []
        allowed = {'space': {'--remove-library'}, 'relink': {'--library'},
                   'release': {'--preview', '--confirm', '--remove-library', '--confirm-library'}}[action]
        need(len(rest) % 2 == 0)
        for flag, value in zip(rest[::2], rest[1::2]):
            need(flag in allowed)
            if flag in ('--library', '--remove-library'):
                need(not value.startswith('/') and '\\' not in value and
                     value.split('/')[0] in ('Filmes', 'Series', 'Series-TV') and
                     all(p not in ('', '.', '..') for p in value.split('/')))
                paths.append(value)
            else:
                need(flag not in options and TOKEN.fullmatch(value))
                options[flag] = value
        need(len(paths) <= 256 and len(set(paths)) == len(paths))
        if action == 'relink':
            need(bool(paths))
        if action == 'release':
            need(options.get('--preview') is not None and options.get('--confirm') == options['--preview'])
            need(not paths or options.get('--confirm-library') == options['--preview'])
    return work


def invoke(kind, args, job_id=None):
    helper = HERE / ('myct-archive-torrent' if kind == 'torrent' else 'myct-archive' if kind == 'file' else 'myct-torrent')
    if not helper.is_file() or helper.is_symlink():
        return {'ok': False, 'error': {'code': 'DEPENDENCIES', 'message': 'Instale todos os helpers complementares no mesmo diretório.'}}
    env = {k: v for k, v in os.environ.items() if k != 'MYCT_CLOUD_JOB'}
    if job_id is not None:
        env['MYCT_CLOUD_JOB'] = job_id
    # Disk spool avoids unbounded capture of large manifests in RAM. Nothing is logged.
    with tempfile.TemporaryFile() as output, tempfile.TemporaryFile() as errors:
        command = [sys.executable, str(helper), *args]
        if job_id is None:
            status = subprocess.call(command, stdout=output, stderr=errors, env=env)
        else:
            # Serialize only spawn with cancellation; never hold delivery.lock during a copy.
            with locked():
                if load(job_id).get('cancel_requested'):
                    return {'ok': False, 'error': {'code': 'INTERRUPTED', 'message': 'Cancelado antes da cópia.'}}
                process = subprocess.Popen(command, stdout=output, stderr=errors, env=env)
            status = process.wait()
        output.seek(0)
        raw = output.read(LIMIT + 1)
    if len(raw) <= LIMIT:
        try:
            reply = json.loads(raw)
            if isinstance(reply, dict):
                if kind == 'rpc' and status == 0:
                    return {'ok': True, **reply}
                if type(reply.get('ok')) is bool:
                    need(status == 0 or not reply['ok'], 'RESPONSE', 'Código de saída inconsistente.')
                    return reply
        except (ValueError, UnicodeError):
            pass
    return {'ok': False, 'error': {'code': 'RESPONSE', 'message': 'Helper sem resposta JSON válida; confira instalação e estado antes de repetir.'}}


def reconcile(row):
    if row['state'] not in ('starting', 'running', 'cancelling'):
        return row
    # A newly accepted start may not yet have reached systemd-run. Never relaunch it.
    if row['state'] == 'starting' and time.time() - row['created'] < 30:
        return row
    check = subprocess.run(['systemctl', '--user', 'show', 'myct-cloud-' + row['id'] + '.service',
                            '--property=ActiveState', '--value'], capture_output=True, text=True, timeout=5)
    if check.returncode == 0 and check.stdout.strip() in ('active', 'activating', 'reloading', 'deactivating'):
        return row
    # Reread after querying systemd: the worker could have just committed its result.
    with locked():
        fresh = load(row['id'])
        if fresh['state'] in ('starting', 'running', 'cancelling'):
            # A collected/inactive unit plus the engine's interruption receipt is proof.
            stopped = check.stdout.strip() == 'inactive'
            cancelled = (fresh['state'] == 'cancelling' and stopped and
                         fresh.get('result', {}).get('error', {}).get('code') == 'INTERRUPTED')
            fresh.update(state='cancelled' if cancelled else 'uncertain', finished=time.time())
            save(fresh)
        return fresh


def rows():
    return sorted((reconcile(load(p.stem)) for p in ROOT.glob('*.json')),
                  key=lambda r: r['created'], reverse=True)


def summary(row):
    result = {k: row[k] for k in ('id', 'work', 'state', 'created', 'finished', 'cancel_supported', 'cancel_requested') if k in row}
    return with_progress(result)


def with_progress(row):
    progress = read_progress(ROOT, row['id'])
    return {**row, **({'progress': progress} if progress is not None else {})}


def library_context():
    """One module/index load per snapshot, never a persistent cache."""
    try:
        helper = HERE / 'myct-archive-torrent'
        need(helper.is_file() and not helper.is_symlink())
        loader = importlib.machinery.SourceFileLoader('cloud_torrent_view', str(helper))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        engine = importlib.util.module_from_spec(spec)
        loader.exec_module(engine)
        return engine, engine.media.load_state()
    except Exception:
        return None


def live_library(row, context):
    """Use one shared index snapshot, including links added after upload."""
    try:
        engine, state = context
        targets = engine.library_targets(row, state)
        return [{'path': path, 'source': source} for path, source in targets.items()], True
    except Exception:
        return row['manifest']['library_links'], False


def snapshot():
    tasks = rows()
    # Engines own the catalogs. Projection only, no Android replica or bridge catalog.
    catalogs = {}
    for kind in ('torrent', 'file'):
        reply = invoke(kind, ['list'])
        if reply.get('ok'):
            context = library_context() if kind == 'torrent' else None
            entries = []
            for row in reply['entries']:
                fields = ('id', 'name', 'size', 'state', 'created_at', 'verified_at', 'error_code',
                          'restore', 'recovery', 'last_restore')
                entry = {k: row[k] for k in fields if k in row}
                if kind == 'torrent':
                    mf = row['manifest']
                    links, checked = live_library(row, context)
                    existing, linked = 0, 0
                    roots = [Path(mf['original_download_dir'])]
                    if row.get('restore', {}).get('path'):
                        roots.append(Path(row['restore']['path']))
                    for link in links:
                        dest = Path.home() / 'Media' / link['path']
                        try:
                            ds = dest.lstat()
                            if not stat.S_ISREG(ds.st_mode):
                                continue
                            existing += 1
                            for root in roots:
                                try:
                                    ss = (root / link['source']).lstat()
                                except OSError:
                                    continue
                                if stat.S_ISREG(ss.st_mode) and (ds.st_dev, ds.st_ino) == (ss.st_dev, ss.st_ino):
                                    linked += 1
                                    break
                        except OSError:
                            pass
                    entry.update(library_existing=existing, library_linked=linked, library_checked=checked,
                                 name=mf['name'], infohash=mf['infohash'], size=mf['total_size'],
                                 library_links=links,
                                 local_present=Path(mf['original_download_dir']).is_dir() or
                                     Path(row.get('restore', {}).get('path', '/nonexistent-myct')).is_dir(),
                                 release={k: row.get('release', {})[k] for k in ('state', 'at', 'error_code')
                                          if k in row.get('release', {})})
                entries.append(entry)
            catalogs[kind] = {'ok': True, 'entries': entries, 'remote_checked': False}
        else:
            catalogs[kind] = reply
    return {'ok': True, 'tasks': [summary(r) for r in tasks[:40]], 'catalogs': catalogs,
            'transmission': invoke('rpc', ['list'])}


def start(identity, work):
    need(ID.fullmatch(identity))
    validate(work)
    # Reconcile before taking the lock; reconciliation itself may lock/write.
    rows()
    with locked():
        if (ROOT / (identity + '.json')).exists():
            prior = load(identity)
            need(prior['work'] == work, 'REQUEST_COLLISION', 'Identificador já usado para outro pedido.')
            return {'ok': True, 'task': summary(prior), 'duplicate': True}
        need(not any(load(p.stem)['state'] in ACTIVE for p in ROOT.glob('*.json')),
             'BUSY', 'Há uma operação em andamento ou incerta. Consulte seu resultado; não a repita.')
        linger = subprocess.run(['loginctl', 'show-user', str(os.getuid()), '-p', 'Linger', '--value'],
                                capture_output=True, text=True, timeout=5)
        need(linger.returncode == 0 and linger.stdout.strip() == 'yes', 'LINGER',
             'Persistência de usuário indisponível. O proprietário deve conferir linger no Fedora.')
        row = {'id': identity, 'work': work, 'state': 'starting', 'created': time.time(),
               'bridge_version': 2, 'cancel_supported': work['args'][0] in ('archive', 'restore')}
        save(row)  # Durable receipt before launch: a lost SSH acknowledgment cannot duplicate work.
        try:
            run = subprocess.run(['systemd-run', '--user', '--quiet', '--collect',
                                  '--unit=myct-cloud-' + identity, '--property=Type=exec',
                                  '--property=UMask=0077', '--property=Nice=10',
                                  '--property=KillMode=control-group', '--property=TimeoutStopSec=15s',
                                  '--property=StandardOutput=null', '--property=StandardError=null',
                                  '--', sys.executable, str(HERE / 'myct-cloud'), '_work', identity],
                                 capture_output=True, timeout=8)
            if run.returncode:
                row.update(state='uncertain', finished=time.time()); save(row)
        except (OSError, subprocess.TimeoutExpired):
            row.update(state='uncertain', finished=time.time()); save(row)
        return {'ok': True, 'task': summary(row), 'duplicate': False}


def unit(identity):
    need(ID.fullmatch(identity))
    return 'myct-cloud-' + identity + '.service'


def cancel(identity):
    need(ID.fullmatch(identity))
    with locked():
        row = load(identity)
        validate(row['work'])
        need(row.get('bridge_version') == 2 and row.get('cancel_supported') is True and
             row['work']['args'][0] in ('archive', 'restore'), 'CANCEL_UNSUPPORTED',
             'Este trabalho não oferece cancelamento seguro. Nenhum processo foi interrompido.')
        if row['state'] not in ('starting', 'running') or row.get('cancel_requested'):
            return {'ok': True, 'task': summary(row)}
        if row['state'] == 'running':
            check = subprocess.run(['systemctl', '--user', 'show', unit(identity),
                                    '--property=Id', '--property=MainPID', '--property=KillMode'],
                                   capture_output=True, text=True, timeout=5)
            fields = dict(line.split('=', 1) for line in check.stdout.splitlines() if '=' in line)
            pid = row.get('worker_pid')
            expected = [sys.executable, str(HERE / 'myct-cloud'), '_work', identity]
            try:
                command = Path('/proc') / str(pid) / 'cmdline'
                actual = command.read_bytes().rstrip(b'\0').decode().split('\0')
            except (OSError, UnicodeError):
                actual = []
            if not (check.returncode == 0 and fields.get('Id') == unit(identity) and
                    type(pid) is int and pid > 0 and fields.get('MainPID') == str(pid) and
                    fields.get('KillMode') == 'control-group' and actual == expected):
                row.update(state='uncertain', finished=time.time()); save(row)
                raise Failure('CANCEL_UNCERTAIN', 'Unidade não confirmada. Consulte o resultado antes de repetir.')
        row.update(cancel_requested=True, cancel_requested_at=time.time())
        save(row)  # Durable explicit intent, before any signal. No repeated stop on replay.
        if row['state'] == 'running':
            try:
                stopped = subprocess.run(['systemctl', '--user', 'stop', '--no-block', unit(identity)],
                                         capture_output=True, timeout=5)
                if stopped.returncode:
                    row.update(state='uncertain', finished=time.time()); save(row)
            except (OSError, subprocess.TimeoutExpired):
                row.update(state='uncertain', finished=time.time()); save(row)
        # A starting worker consumes the durable flag without invoking the engine.
        return {'ok': True, 'task': summary(row)}


def worker(identity):
    # systemd stop signals this worker AND its cgroup. Keep the worker alive to
    # collect the engine's sanitized interruption result; systemd enforces 15 s.
    signal.signal(signal.SIGTERM, lambda *_: None)
    with locked():
        row = load(identity)
        if row['state'] != 'starting':
            return
        validate(row['work'])
        row.update(state='running', worker_pid=os.getpid()); save(row)
    progress = Progress(ROOT, identity)
    progress.phase('preparing')
    try:
        with locked():
            requested = load(identity).get('cancel_requested')
        result = ({'ok': False, 'error': {'code': 'INTERRUPTED', 'message': 'Cancelado antes de iniciar a cópia.'}}
                  if requested else invoke(row['work']['kind'], row['work']['args'], identity))
        state = 'succeeded' if result.get('ok') else 'failed'
        with locked():
            row = load(identity)  # Preserve a cancel intent committed while the engine ran.
            if row.get('cancel_requested') and result.get('error', {}).get('code') == 'INTERRUPTED':
                state = 'cancelling'
            elif row.get('cancel_requested') and result.get('error', {}).get('code') == 'RESPONSE':
                state = 'uncertain'
            row.update(state=state, result=result, finished=time.time()); save(row)
    except Exception:
        with locked():
            row = load(identity)
            row.update(state='uncertain', finished=time.time()); save(row)
    if row['state'] in ('succeeded', 'failed', 'cancelling'):
        progress.finish(row['state'] == 'succeeded')


def run(args):
    private_root()
    if args == ['snapshot']:
        return snapshot()
    if len(args) == 2 and args[0] == 'task':
        return {'ok': True, 'task': with_progress(reconcile(load(args[1])))}
    if len(args) == 2 and args[0] == 'cancel':
        return cancel(args[1])
    if len(args) == 3 and args[0] == 'start':
        need(len(args[2]) <= 200000 and re.fullmatch('[A-Za-z0-9_-]+', args[2]))
        work = json.loads(base64.urlsafe_b64decode(args[2] + '=' * (-len(args[2]) % 4)))
        return start(args[1], work)
    if len(args) == 2 and args[0] == '_work':
        worker(args[1]); return {'ok': True}
    raise Failure('USAGE', 'Use snapshot, task ID, cancel ID ou start ID PEDIDO_BASE64URL.')


def main():
    os.umask(0o077)
    # Delivery must finish its small durable receipt even if SSH disappears.
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    try:
        result = run(sys.argv[1:])
    except Failure as error:
        result = {'ok': False, 'error': {'code': error.code, 'message': str(error)}}
    except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired):
        result = {'ok': False, 'error': {'code': 'JOURNAL_OR_SYSTEMD',
                  'message': 'Não foi possível confirmar o estado. Consulte novamente; não repita automaticamente.'}}
    print(json.dumps(result, ensure_ascii=True))
    return 0 if result.get('ok') else 2


if __name__ == '__main__':
    sys.exit(main())

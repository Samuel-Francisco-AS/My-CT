#!/usr/bin/python3
"""Small SSH-facing Transmission 4.1+ adapter; no daemon, third-party modules or shell."""
import base64
from contextlib import contextmanager
import fcntl
import http.client
import ipaddress
import json
import os
from pathlib import Path
import re
import socket
import sys
import time
import unicodedata
from urllib.parse import parse_qs, parse_qsl, urlencode, urlsplit

ENDPOINT_PORT = 19091
LIMIT = 262144
FIELDS = ['id', 'hash_string', 'name', 'status', 'total_size', 'size_when_done',
          'left_until_done', 'percent_done', 'metadata_percent_complete', 'rate_download',
          'rate_upload', 'peers_connected', 'download_dir', 'error', 'error_string',
          'downloaded_ever', 'uploaded_ever', 'upload_ratio']

class Failure(Exception):
    pass

def destination():
    path = Path.home() / 'Downloads/My-CT/Torrents'
    # Do not follow a redirected managed tree outside its documented destination.
    if path.resolve() != path:
        raise Failure('Destino redirecionado por link simbólico; operação recusada.')
    return path

def magnet(value):
    if len(value) > 8192 or any(ord(c) < 32 or ord(c) == 127 for c in value):
        raise Failure('Magnet inválido.')
    uri = urlsplit(value)
    query = parse_qs(uri.query, strict_parsing=True)
    if uri.scheme != 'magnet' or uri.netloc or uri.path or uri.fragment:
        raise Failure('Magnet inválido.')
    if set(query) - {'xt', 'dn', 'tr'} or len(query.get('xt', [])) != 1:
        raise Failure('Use magnet com xt, dn e trackers tr; fontes web xs/as/ws não são aceitas.')
    if not re.fullmatch(r'urn:btih:(?:[0-9a-fA-F]{40}|[A-Z2-7a-z]{32})', query['xt'][0]):
        raise Failure('Magnet precisa de infohash BitTorrent v1 válido.')
    unresolved = set()
    for tracker in query.get('tr', []):
        url = urlsplit(tracker)
        if url.scheme not in {'http', 'https', 'udp'} or not url.hostname or url.username or url.password:
            raise Failure('Tracker inválido.')
        try:
            addresses = socket.getaddrinfo(url.hostname, url.port or 80, type=socket.SOCK_DGRAM)
        except socket.gaierror:
            # A dead DNS entry must not prevent other trackers or DHT from working.
            # Do not pass unverified hostnames to the daemon.
            unresolved.add(tracker)
            continue
        except OSError as error:
            raise Failure('Falha de rede ao validar tracker.') from error
        if not addresses or any(not ipaddress.ip_address(row[4][0]).is_global for row in addresses):
            raise Failure('Tracker precisa de endereço público.')
    if not unresolved:
        return value
    pairs = parse_qsl(uri.query, keep_blank_values=True, strict_parsing=True)
    kept = [(key, val) for key, val in pairs if key != 'tr' or val not in unresolved]
    return uri._replace(query=urlencode(kept)).geturl()

class Rpc:
    def call(self, method, params):
        token = ''
        body = json.dumps({'jsonrpc': '2.0', 'id': 1, 'method': method, 'params': params})
        for _ in range(2):
            conn = http.client.HTTPConnection('127.0.0.1', ENDPOINT_PORT, timeout=7)
            try:
                conn.request('POST', '/transmission/rpc', body,
                             {'Content-Type': 'application/json', 'X-Transmission-Session-Id': token})
                response = conn.getresponse()
                if response.status == 409:
                    token = response.getheader('X-Transmission-Session-Id', '')
                    if not re.fullmatch('[A-Za-z0-9]{1,128}', token):
                        raise Failure('Token RPC inválido.')
                    continue  # 409 is a rejection before execution, not an ambiguous retry.
                if response.status != 200:
                    raise Failure('RPC recusado. Confira configuração local do Transmission.')
                payload = response.read(LIMIT + 1)
                if len(payload) > LIMIT:
                    raise Failure('Histórico excedeu 256 KiB; consulte pelo Transmission local.')
                result = json.loads(payload)
                if result.get('jsonrpc') != '2.0' or result.get('id') != 1 or 'error' in result:
                    raise Failure('Pedido recusado pelo motor; requer Transmission 4.1+. Atualize antes de repetir.')
                return result['result']
            finally:
                conn.close()
        raise Failure('Falha na negociação RPC.')

def naming_file(key):
    if not re.fullmatch('[0-9a-f]{40}', key):
        raise Failure('Hash inválido.')
    path = Path.home() / '.local/share/myct/torrent-names'
    if path.resolve() != path:
        raise Failure('Registro de nomes redirecionado por symlink.')
    return path / (key + '.json')

@contextmanager
def naming_lock(key):
    path = naming_file(key)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with path.with_suffix('.lock').open('a') as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        yield

def read_naming(key):
    path = naming_file(key)
    if not path.exists():
        return None
    if path.is_symlink():
        raise Failure('Registro de nomes inválido.')
    data = json.loads(path.read_text())
    target = data.get('target')
    if target is not None and (not isinstance(target, str) or
            not safe_named_component(target, key)):
        raise Failure('Destino registrado inválido.')
    if data.get('state') not in {'pending', 'submitted', 'done', 'blocked'}:
        raise Failure('Estado de nomeação inválido.')
    return data

def write_naming(key, data):
    path = naming_file(key)
    temp = path.with_suffix('.tmp')
    # Called under the per-hash lock. Atomic metadata update, never torrent data.
    with temp.open('w') as stream:
        json.dump(data, stream, ensure_ascii=True)
        stream.flush()
        os.fsync(stream.fileno())
    temp.replace(path)
    fd = os.open(path.parent, os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)

def safe_named_component(value, key):
    return (len(value.encode('utf-8')) <= 160 and
            value.endswith('-' + key[:8]) and not value.startswith('.') and
            all(unicodedata.category(c)[0] in 'LNM' or c in ' ._-()' for c in value))

def readable_name(title, key):
    title = unicodedata.normalize('NFC', title)
    title = ''.join(c if unicodedata.category(c)[0] in 'LNM' or c in ' ._-()' else '-' for c in title)
    title = re.sub(r'[-\s]+', '-', title).strip(' .-_')
    title = title.encode('utf-8')[:120].decode('utf-8', errors='ignore').rstrip(' .-_') or 'torrent'
    if title.split('.')[0].upper() in {'CON', 'PRN', 'AUX', 'NUL', *(f'COM{i}' for i in range(1,10)), *(f'LPT{i}' for i in range(1,10))}:
        title = 'torrent-' + title
    return title + '-' + key[:8]

def records(rpc, ids=None):
    args = {'fields': FIELDS}
    if ids is not None:
        args['ids'] = ids
    rows = rpc.call('torrent_get', args)['torrents']
    root = destination()
    def managed(row):
        key = row.get('hash_string', '')
        if re.fullmatch('[0-9a-f]{40}', key) is None:
            return False
        allowed = [root / key]  # Legacy directories remain valid and are never migrated.
        data = read_naming(key)
        if data and data.get('target'):
            allowed.append(root / data['target'])
        return any(row.get('download_dir') == str(path) and path.resolve() == path for path in allowed)
    return [row for row in rows if managed(row)]

def organize(rpc, key):
    with naming_lock(key):
        data = read_naming(key)
        if data is None:
            return {'naming': 'legacy-untouched'}
        rows = records(rpc, [key])
        if len(rows) != 1:
            return {'naming': 'torrent-absent-or-external'}
        row = rows[0]
        # A submitted operation is never sent twice, even after a timeout/crash.
        if data['state'] != 'pending':
            if data.get('target') and row['download_dir'] == str(destination() / data['target']):
                data['state'] = 'done'
                write_naming(key, data)
            return {'naming': data['state']}
        if row.get('metadata_percent_complete') != 1 or row.get('left_until_done') != 0:
            return {'naming': 'waiting-for-completion'}
        if row['download_dir'] != str(destination() / key) or row.get('error', 0) == 3:
            return {'naming': 'waiting-for-valid-source'}
        target = destination() / readable_name(row['name'], key)
        # Reserve an empty directory exclusively. Never merge with existing data.
        try:
            target.mkdir(mode=0o700)
        except FileExistsError:
            write_naming(key, {'state': 'blocked', 'target': None, 'reason': 'destination-exists'})
            return {'naming': 'blocked-destination-exists'}
        data = {'state': 'submitted', 'target': target.name}
        write_naming(key, data)
        rpc.call('torrent_set_location', {'ids': [key], 'location': str(target), 'move': True})
        # RPC acceptance is asynchronous. Confirm from daemon; never move files ourselves.
        for _ in range(20):
            current = records(rpc, [key])
            if len(current) == 1 and current[0]['download_dir'] == str(target):
                data['state'] = 'done'
                write_naming(key, data)
                break
            time.sleep(0.1)
        return {'naming': data['state']}

def enable_naming(rpc):
    hook = Path.home() / '.local/bin/myct-torrent-done'
    current = rpc.call('session_get', {'fields': ['config_dir', 'script_torrent_done_enabled', 'script_torrent_done_filename']})
    if current['config_dir'] != str(Path.home() / '.config/myct-transmission'):
        raise Failure('Instância dedicada My-CT não confirmada.')
    if current.get('script_torrent_done_filename') not in ('', str(hook)):
        raise Failure('Hook existente preservado; nomeação não ativada.')
    if not hook.is_file() or hook.is_symlink() or not os.access(hook, os.X_OK):
        raise Failure('Instale myct-torrent-done antes de ativar nomeação.')
    rpc.call('session_set', {'script_torrent_done_enabled': True, 'script_torrent_done_filename': str(hook)})
    return {'naming': 'enabled-on-completion'}

def run(args, rpc):
    if args == ['list']:
        return {'torrents': records(rpc)}
    if len(args) == 2 and args[0] == 'add':
        value = magnet(args[1])
        xt = parse_qs(urlsplit(value).query)['xt'][0].split(':')[-1]
        key = xt.lower() if len(xt) == 40 else base64.b32decode(xt.upper()).hex()
        with naming_lock(key):
            data = read_naming(key)
            root = destination() / (data['target'] if data and data.get('target') else key)
            if root.resolve() != root:
                raise Failure('Destino redirecionado; operação recusada.')
            fresh = not root.exists() and data is None
            root.mkdir(parents=True, exist_ok=True, mode=0o700)
            # Register eligibility before allowing a new torrent to finish. Duplicates untouched.
            result = rpc.call('torrent_add', {'filename': value, 'download_dir': str(root), 'paused': True})
            duplicate = 'torrent_duplicate' in result
            item = result.get('torrent_duplicate') if duplicate else result.get('torrent_added')
            if not item or item.get('hash_string', '').lower() != key:
                raise Failure('Resposta de inclusão inválida; consulte antes de repetir.')
            if not duplicate:
                if fresh:
                    write_naming(key, {'state': 'pending', 'target': None})
                rpc.call('torrent_start', {'ids': [key]})
            return {'duplicate': duplicate, 'id': item['id'], 'hash': item['hash_string']}
    if args == ['enable-naming']:
        return enable_naming(rpc)
    if len(args) == 2 and args[0] == 'organize':
        return organize(rpc, args[1].lower())
    if len(args) == 2 and args[0] in {'pause', 'resume', 'remove', 'status'}:
        key = args[1]
        if not re.fullmatch('[0-9a-fA-F]{40}', key):
            raise Failure('Use o hash completo da transferência, nunca all ou ID numérico.')
        rows = records(rpc, [key])
        if len(rows) != 1:
            raise Failure('Torrent ausente ou fora do diretório My-CT.')
        verb = args[0]
        if verb == 'status':
            return {'torrents': rows}
        method = {'pause': 'torrent_stop', 'resume': 'torrent_start', 'remove': 'torrent_remove'}[verb]
        params = {'ids': [key]}
        if verb == 'remove':
            params['delete_local_data'] = False
        rpc.call(method, params)
        return {'ok': True, 'hash': key}
    raise Failure('Uso: myct-torrent list | add MAGNET | status/pause/resume/remove HASH')

def main():
    os.umask(0o077)
    try:
        output = json.dumps(run(sys.argv[1:], Rpc()), ensure_ascii=True)
        if len(output.encode()) > LIMIT:
            raise Failure('Histórico excedeu 256 KiB; consulte pelo Transmission local.')
        print(output)
    except (OSError, TimeoutError, http.client.HTTPException):
        print('Transmission indisponível. Confira pacote transmission-daemon e myct-transmission.service.', file=sys.stderr)
        return 3
    except (Failure, ValueError, KeyError, TypeError) as error:
        print(str(error) if isinstance(error, Failure) else 'Resposta ou argumento inválido.', file=sys.stderr)
        return 2
    return 0

if __name__ == '__main__':
    sys.exit(main())

#!/usr/bin/python3
"""Small SSH-facing Transmission 4.1+ adapter; no daemon, third-party modules or shell."""
import base64
from contextlib import contextmanager
import fcntl
import http.client
import hashlib
import select
import ipaddress
import json
import os
from pathlib import Path
import re
import socket
import sys
import time
import unicodedata
from urllib.parse import parse_qs, unquote_plus, urlsplit, urlencode

ENDPOINT_PORT = 19091
LIMIT = 262144
FIELDS = ['id', 'hash_string', 'name', 'status', 'total_size', 'size_when_done',
          'left_until_done', 'percent_done', 'metadata_percent_complete', 'rate_download',
          'rate_upload', 'peers_connected', 'download_dir', 'error', 'error_string',
          'downloaded_ever', 'uploaded_ever', 'upload_ratio']

class Failure(Exception):
    pass

def destination():
    path = Path.home() / 'Downloads/My-CT/Torrents'
    # Do not follow a redirected managed tree outside its documented destination.
    if path.resolve() != path:
        raise Failure('Destino redirecionado por link simbólico; operação recusada.')
    return path

def magnet(value):
    if len(value) > 8192 or any(ord(c) < 32 or ord(c) == 127 for c in value):
        raise Failure('Magnet inválido.')
    uri = urlsplit(value)
    # Some magnet generators insert repeated or trailing '&' separators.
    # Ignore only empty segments; keep strict validation for real fields.
    raw_parts = uri.query.split('&')
    parts = [part for part in raw_parts if part]
    query = parse_qs('&'.join(parts), strict_parsing=True)
    if uri.scheme != 'magnet' or uri.netloc or uri.path or uri.fragment:
        raise Failure('Magnet inválido.')
    if set(query) - {'xt', 'dn', 'tr'} or len(query.get('xt', [])) != 1:
        raise Failure('Use magnet com xt, dn e trackers tr; fontes web xs/as/ws não são aceitas.')
    if not re.fullmatch(r'urn:btih:(?:[0-9a-fA-F]{40}|[A-Z2-7a-z]{32})', query['xt'][0]):
        raise Failure('Magnet precisa de infohash BitTorrent v1 válido.')
    skipped = set()
    for tracker in query.get('tr', []):
        url = urlsplit(tracker)
        if url.scheme not in {'http', 'https', 'udp'} or not url.hostname or url.username or url.password:
            raise Failure('Tracker inválido.')
        try:
            literal = ipaddress.ip_address(url.hostname)
        except ValueError:
            literal = None
        if literal is not None and not literal.is_global:
            # Explicit internal addresses remain invalid even if other trackers work.
            raise Failure('Tracker precisa de endereço público.')
        try:
            addresses = socket.getaddrinfo(url.hostname, url.port or 80, type=socket.SOCK_DGRAM)
        except socket.gaierror:
            # Drop unusable trackers; never send unresolved hosts to the daemon.
            skipped.add(tracker)
            continue
        except OSError as error:
            raise Failure('Falha de rede ao validar tracker.') from error
        if not addresses or any(not ipaddress.ip_address(row[4][0]).is_global for row in addresses):
            # A hostname may resolve to private/reserved IPs or mixed IP families.
            # Do not forward it, but do not sacrifice otherwise usable trackers.
            skipped.add(tracker)
    if not skipped and len(parts) == len(raw_parts):
        return value
    # Do not re-encode the query: Transmission 4.1.3 expects the literal
    # "xt=urn:btih:" prefix. urlencode() turns ':' into '%3A', and the
    # daemon rejects that otherwise valid magnet as "unrecognized info".
    # Drop empty separators and invalid trackers, preserving raw values.
    kept = []
    for part in parts:
        raw_key, _, raw_value = part.partition('=')
        if unquote_plus(raw_key) == 'tr' and unquote_plus(raw_value) in skipped:
            continue
        kept.append(part)
    return uri._replace(query='&'.join(kept)).geturl()

class Rpc:
    def call(self, method, params):
        token = ''
        body = json.dumps({'jsonrpc': '2.0', 'id': 1, 'method': method, 'params': params})
        for _ in range(2):
            conn = http.client.HTTPConnection('127.0.0.1', ENDPOINT_PORT, timeout=7)
            try:
                conn.request('POST', '/transmission/rpc', body,
                             {'Content-Type': 'application/json', 'X-Transmission-Session-Id': token})
                response = conn.getresponse()
                if response.status == 409:
                    token = response.getheader('X-Transmission-Session-Id', '')
                    if not re.fullmatch('[A-Za-z0-9]{1,128}', token):
                        raise Failure('Token RPC inválido.')
                    continue  # 409 is a rejection before execution, not an ambiguous retry.
                if response.status != 200:
                    raise Failure('RPC recusado. Confira configuração local do Transmission.')
                payload = response.read(LIMIT + 1)
                if len(payload) > LIMIT:
                    raise Failure('Histórico excedeu 256 KiB; consulte pelo Transmission local.')
                result = json.loads(payload)
                if not isinstance(result, dict) or result.get('jsonrpc') != '2.0' or result.get('id') != 1:
                    raise Failure('Resposta RPC inválida ou incompatível.')
                if 'error' in result:
                    error = result['error']
                    if isinstance(error, dict) and isinstance(error.get('code'), int) and isinstance(error.get('message'), str):
                        # The daemon's short JSON-RPC error message is more useful
                        # than blaming its version. Never print request params/magnet.
                        message = ('metadados recusados' if method == 'torrent_add' and 'metainfo' in params else
                                   re.sub(r'[\x00-\x1f\x7f]+', ' ', error['message']).strip()[:160])
                        raise Failure(f'Transmission recusou {method}: {message} (código {error["code"]}).')
                    raise Failure(f'Transmission recusou {method}: erro RPC sem detalhes válidos.')
                if not isinstance(result.get('result'), dict):
                    raise Failure('Resposta RPC sem resultado válido.')
                return result['result']
            finally:
                conn.close()
        raise Failure('Falha na negociação RPC.')

def naming_file(key):
    if not re.fullmatch('[0-9a-f]{40}', key):
        raise Failure('Hash inválido.')
    path = Path.home() / '.local/share/myct/torrent-names'
    if path.resolve() != path:
        raise Failure('Registro de nomes redirecionado por symlink.')
    return path / (key + '.json')

@contextmanager
def naming_lock(key):
    path = naming_file(key)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with path.with_suffix('.lock').open('a') as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        yield

def read_naming(key):
    path = naming_file(key)
    if not path.exists():
        return None
    if path.is_symlink():
        raise Failure('Registro de nomes inválido.')
    data = json.loads(path.read_text())
    target = data.get('target')
    if target is not None and (not isinstance(target, str) or
            not safe_named_component(target, key)):
        raise Failure('Destino registrado inválido.')
    if data.get('state') not in {'pending', 'submitted', 'done', 'blocked'}:
        raise Failure('Estado de nomeação inválido.')
    return data

def write_naming(key, data):
    path = naming_file(key)
    temp = path.with_suffix('.tmp')
    # Called under the per-hash lock. Atomic metadata update, never torrent data.
    with temp.open('w') as stream:
        json.dump(data, stream, ensure_ascii=True)
        stream.flush()
        os.fsync(stream.fileno())
    temp.replace(path)
    fd = os.open(path.parent, os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)

def safe_named_component(value, key):
    return (len(value.encode('utf-8')) <= 160 and
            value.endswith('-' + key[:8]) and not value.startswith('.') and
            all(unicodedata.category(c)[0] in 'LNM' or c in ' ._-()' for c in value))

def readable_name(title, key):
    title = unicodedata.normalize('NFC', title)
    title = ''.join(c if unicodedata.category(c)[0] in 'LNM' or c in ' ._-()' else '-' for c in title)
    title = re.sub(r'[-\s]+', '-', title).strip(' .-_')
    title = title.encode('utf-8')[:120].decode('utf-8', errors='ignore').rstrip(' .-_') or 'torrent'
    if title.split('.')[0].upper() in {'CON', 'PRN', 'AUX', 'NUL', *(f'COM{i}' for i in range(1,10)), *(f'LPT{i}' for i in range(1,10))}:
        title = 'torrent-' + title
    return title + '-' + key[:8]

def records(rpc, ids=None):
    args = {'fields': FIELDS}
    if ids is not None:
        args['ids'] = ids
    rows = rpc.call('torrent_get', args)['torrents']
    root = destination()
    def managed(row):
        key = row.get('hash_string', '')
        if re.fullmatch('[0-9a-f]{40}', key) is None:
            return False
        allowed = [root / key]  # Legacy directories remain valid and are never migrated.
        data = read_naming(key)
        if data and data.get('target'):
            allowed.append(root / data['target'])
        return any(row.get('download_dir') == str(path) and path.resolve() == path for path in allowed)
    return [row for row in rows if managed(row)]

def organize(rpc, key):
    with naming_lock(key):
        data = read_naming(key)
        if data is None:
            return {'naming': 'legacy-untouched'}
        rows = records(rpc, [key])
        if len(rows) != 1:
            return {'naming': 'torrent-absent-or-external'}
        row = rows[0]
        # A submitted operation is never sent twice, even after a timeout/crash.
        if data['state'] != 'pending':
            if data.get('target') and row['download_dir'] == str(destination() / data['target']):
                data['state'] = 'done'
                write_naming(key, data)
            return {'naming': data['state']}
        if row.get('metadata_percent_complete') != 1 or row.get('left_until_done') != 0:
            return {'naming': 'waiting-for-completion'}
        if row['download_dir'] != str(destination() / key) or row.get('error', 0) == 3:
            return {'naming': 'waiting-for-valid-source'}
        target = destination() / readable_name(row['name'], key)
        # Reserve an empty directory exclusively. Never merge with existing data.
        try:
            target.mkdir(mode=0o700)
        except FileExistsError:
            write_naming(key, {'state': 'blocked', 'target': None, 'reason': 'destination-exists'})
            return {'naming': 'blocked-destination-exists'}
        data = {'state': 'submitted', 'target': target.name}
        write_naming(key, data)
        rpc.call('torrent_set_location', {'ids': [key], 'location': str(target), 'move': True})
        # RPC acceptance is asynchronous. Confirm from daemon; never move files ourselves.
        for _ in range(20):
            current = records(rpc, [key])
            if len(current) == 1 and current[0]['download_dir'] == str(target):
                data['state'] = 'done'
                write_naming(key, data)
                break
            time.sleep(0.1)
        return {'naming': data['state']}

def enable_naming(rpc):
    hook = Path.home() / '.local/bin/myct-torrent-done'
    current = rpc.call('session_get', {'fields': ['config_dir', 'script_torrent_done_enabled', 'script_torrent_done_filename']})
    if current['config_dir'] != str(Path.home() / '.config/myct-transmission'):
        raise Failure('Instância dedicada My-CT não confirmada.')
    if current.get('script_torrent_done_filename') not in ('', str(hook)):
        raise Failure('Hook existente preservado; nomeação não ativada.')
    if not hook.is_file() or hook.is_symlink() or not os.access(hook, os.X_OK):
        raise Failure('Instale myct-torrent-done antes de ativar nomeação.')
    rpc.call('session_set', {'script_torrent_done_enabled': True, 'script_torrent_done_filename': str(hook)})
    return {'naming': 'enabled-on-completion'}

def refuse_shared_data(folder):
    """Reject deleting any original with external hardlinks (e.g. Jellyfin)."""
    if folder.is_symlink() or folder.resolve() != folder:
        raise Failure('Diretório do torrent redirecionado; exclusão recusada.')
    if not folder.exists():
        return
    if not folder.is_dir():
        raise Failure('Diretório do torrent inválido.')
    stack = [folder]
    checked = 0
    while stack:
        current = stack.pop()
        for entry in current.iterdir():
            checked += 1
            if checked > 20000:
                raise Failure('Torrent excede limite de verificação. Exclusão recusada.')
            if entry.is_symlink():
                raise Failure('Torrent contém link simbólico. Exclusão recusada.')
            if entry.is_dir():
                stack.append(entry)
            elif entry.is_file():
                if entry.stat().st_nlink > 1:
                    raise Failure('Torrent possui hardlinks em outra biblioteca. ' +
                                  'Use Mídia → Armazenamento para remover os vínculos primeiro.')
            else:
                raise Failure('Torrent contém entrada não regular. Exclusão recusada.')


def delete_torrent_data(rpc, key):
    """Only a dedicated My-CT torrent folder may be deleted by Transmission."""
    state = Path.home() / '.local/share/myct/media'
    if state.is_symlink() or state.resolve() != state:
        raise Failure('Estado Media redirecionado; exclusão recusada.')
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock = state / 'state.lock'
    if lock.is_symlink():
        raise Failure('Lock de mídia inválido.')
    with naming_lock(key), lock.open('a') as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        items = records(rpc, [key])
        if len(items) != 1:
            raise Failure('Torrent ausente ou fora do diretório My-CT.')
        row = items[0]
        folder = Path(row['download_dir'])
        if folder.parent != destination() or folder.is_symlink():
            raise Failure('Diretório não gerenciado; operação recusada.')
        refuse_shared_data(folder)
        # Check metadata, too: links may have been registered before a source vanished.
        index = state / 'state.json'
        if index.exists():
            if index.is_symlink():
                raise Failure('Índice de mídia inválido.')
            data = json.loads(index.read_text())
            if any(info.get('id', '').startswith(key + ':')
                   for info in data.get('links', {}).values()):
                raise Failure('Torrent ainda possui mídia vinculada ao Jellyfin. ' +
                              'Retire esses hardlinks na aba Armazenamento antes de excluir.')
        rpc.call('torrent_remove', {'ids': [key], 'delete_local_data': True})
        # Transmission removes payload; never recurse through the directory ourselves.
        try:
            folder.rmdir()
        except OSError:
            pass
        # Allow re-adding the same magnet after deletion.
        record = naming_file(key)
        if record.exists() and not record.is_symlink():
            record.unlink()
        return {'ok': True, 'hash': key, 'deleted_data': True}


MAX_META = 4 * 1024 * 1024


def metainfo(raw):
    """Validate bounded v1 metainfo and hash the original info byte span.

    Trackers and private flags are preserved verbatim, never rebuilt as a magnet.
    Mirrors the C1 archive validator's supported v1 subset without its file IO.
    """
    if not isinstance(raw, bytes) or not 0 < len(raw) <= MAX_META:
        raise Failure('Arquivo .torrent ausente ou maior que 4 MiB.')
    pos, span, nodes = 0, None, 0

    def parse(depth=0):
        nonlocal pos, span, nodes
        nodes += 1
        if depth > 32 or nodes > 100000 or pos >= len(raw):
            raise ValueError()
        start = pos
        token = raw[pos:pos + 1]
        pos += 1
        if token == b'i':
            end = raw.index(b'e', pos)
            value = raw[pos:end]
            if not re.fullmatch(b'(?:0|-[1-9][0-9]*|[1-9][0-9]*)', value) or len(value) > 20:
                raise ValueError()
            pos = end + 1
            return int(value)
        if token in (b'l', b'd'):
            result = [] if token == b'l' else {}
            previous = None
            while raw[pos:pos + 1] != b'e':
                if isinstance(result, list):
                    result.append(parse(depth + 1))
                else:
                    name = parse(depth + 1)
                    if not isinstance(name, bytes) or (previous is not None and name <= previous):
                        raise ValueError()
                    previous = name
                    begin = pos
                    result[name] = parse(depth + 1)
                    if depth == 0 and name == b'info':
                        span = (begin, pos)
            pos += 1
            return result
        colon = raw.index(b':', start)
        length = raw[start:colon]
        if not re.fullmatch(b'(?:0|[1-9][0-9]*)', length) or len(length) > 8:
            raise ValueError()
        end = colon + 1 + int(length)
        if end > len(raw):
            raise ValueError()
        pos = end
        return raw[colon + 1:end]

    def component(value):
        text = value.decode('utf-8')
        if (not text or text in ('.', '..') or len(value) > 255 or
                any(c in text for c in '/\\') or any(ord(c) < 32 or ord(c) == 127 for c in text)):
            raise ValueError()
        return text

    try:
        root = parse()
        if pos != len(raw) or span is None or not isinstance(root, dict):
            raise ValueError()
        info = root[b'info']
        if not isinstance(info, dict) or any(k in info for k in (b'meta version', b'file tree', b'attr', b'symlink path')):
            raise ValueError()
        name = component(info[b'name'])
        if b'name.utf-8' in info:
            component(info[b'name.utf-8'])
        pieces, size = info[b'pieces'], info[b'piece length']
        if type(size) is not int or size <= 0 or not isinstance(pieces, bytes):
            raise ValueError()
        if b'files' in info:
            if b'length' in info or not isinstance(info[b'files'], list) or not 1 <= len(info[b'files']) <= 20000:
                raise ValueError()
            files = []
            for row in info[b'files']:
                if not isinstance(row, dict) or any(k in row for k in (b'attr', b'symlink path')):
                    raise ValueError()
                parts = row[b'path']
                if not isinstance(parts, list) or not parts:
                    raise ValueError()
                path = tuple(component(p) for p in parts)
                if b'path.utf-8' in row:
                    # Avoid alternate path layouts interpreted differently by clients.
                    if row[b'path.utf-8'] != parts:
                        raise ValueError()
                files.append((path, row[b'length']))
            paths = {f[0] for f in files}
            if len(paths) != len(files) or any(path[:i] in paths for path in paths for i in range(1, len(path))):
                raise ValueError()
        else:
            files = [((name,), info[b'length'])]
        if any(type(length) is not int or not 0 <= length <= 2**63 - 1 for _, length in files):
            raise ValueError()
        total = sum(length for _, length in files)
        if total <= 0 or total > 2**63 - 1 or len(pieces) != 20 * ((total + size - 1) // size):
            raise ValueError()
        if b'private' in info and info[b'private'] not in (0, 1):
            raise ValueError()
        # Web seeds would introduce a separate HTTP download path in the daemon.
        if any(k in root for k in (b'url-list', b'httpseeds', b'nodes')):
            raise ValueError()
        trackers = []
        if b'announce' in root:
            trackers.append(root[b'announce'].decode('utf-8'))
        if b'announce-list' in root:
            if not isinstance(root[b'announce-list'], list):
                raise ValueError()
            for tier in root[b'announce-list']:
                if not isinstance(tier, list):
                    raise ValueError()
                trackers.extend(tracker.decode('utf-8') for tracker in tier)
        if len(trackers) > 128 or (info.get(b'private') == 1 and not trackers):
            raise ValueError()
        if trackers:
            # Reuse the existing tracker address policy, but refuse instead of
            # stripping any private torrent's necessary authenticated tracker.
            test = 'magnet:?xt=urn:btih:' + '0' * 40 + '&' + urlencode([('tr', t) for t in trackers])
            if magnet(test) != test:
                raise Failure('Tracker indisponível ou restrito; .torrent recusado sem remover trackers.')
        return hashlib.sha1(raw[slice(*span)], usedforsecurity=False).hexdigest()
    except (ValueError, TypeError, KeyError, IndexError, AttributeError, UnicodeError, RecursionError):
        raise Failure('Metadados v1 inválidos ou incompatíveis; v2, híbridos, arquivos especiais e web seeds não são suportados.') from None


def read_metainfo():
    deadline = time.monotonic() + 10
    raw = bytearray()
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0 or not select.select([sys.stdin.buffer], [], [], remaining)[0]:
            raise Failure('Tempo limite ao receber .torrent por stdin.')
        chunk = os.read(sys.stdin.buffer.fileno(), min(65536, MAX_META + 1 - len(raw)))
        if not chunk:
            return bytes(raw)
        raw.extend(chunk)
        if len(raw) > MAX_META:
            raise Failure('Arquivo .torrent maior que 4 MiB.')


def add_source(rpc, key, source):
    with naming_lock(key):
        data = read_naming(key)
        root = destination() / (data['target'] if data and data.get('target') else key)
        if root.resolve() != root:
            raise Failure('Destino redirecionado; operação recusada.')
        fresh = not root.exists() and data is None
        root.mkdir(parents=True, exist_ok=True, mode=0o700)
        result = rpc.call('torrent_add', {**source, 'download_dir': str(root), 'paused': True})
        duplicate = 'torrent_duplicate' in result
        item = result.get('torrent_duplicate') if duplicate else result.get('torrent_added')
        if not item or item.get('hash_string', '').lower() != key:
            raise Failure('Resposta de inclusão inválida; consulte antes de repetir.')
        if not duplicate:
            if fresh:
                write_naming(key, {'state': 'pending', 'target': None})
            rpc.call('torrent_start', {'ids': [key]})
        return {'duplicate': duplicate, 'id': item['id'], 'hash': item['hash_string']}


def run(args, rpc, raw=None):
    if args == ['list']:
        return {'torrents': records(rpc)}
    if len(args) == 2 and args[0] == 'add':
        value = magnet(args[1])
        xt = parse_qs(urlsplit(value).query)['xt'][0].split(':')[-1]
        key = xt.lower() if len(xt) == 40 else base64.b32decode(xt.upper()).hex()
        return add_source(rpc, key, {'filename': value})
    if len(args) in (1, 2) and args[0] == 'add-metainfo-stdin':
        if len(args) == 2 and not re.fullmatch('[0-9a-f]{40}', args[1]):
            raise Failure('Infohash esperado inválido.')
        raw = read_metainfo() if raw is None else raw
        key = metainfo(raw)
        if len(args) == 2 and args[1] != key:
            raise Failure('Arquivo .torrent não corresponde ao infohash do resultado. Pesquise novamente.')
        return add_source(rpc, key, {'metainfo': base64.b64encode(raw).decode('ascii')})
    if args == ['enable-naming']:
        return enable_naming(rpc)
    if len(args) == 2 and args[0] == 'organize':
        return organize(rpc, args[1].lower())
    if len(args) == 2 and args[0] == 'delete-data':
        key = args[1].lower()
        if not re.fullmatch('[0-9a-f]{40}', key):
            raise Failure('Use o hash completo do torrent.')
        return delete_torrent_data(rpc, key)
    if len(args) == 2 and args[0] in {'pause', 'resume', 'remove', 'status'}:
        key = args[1]
        if not re.fullmatch('[0-9a-fA-F]{40}', key):
            raise Failure('Use o hash completo da transferência, nunca all ou ID numérico.')
        rows = records(rpc, [key])
        if len(rows) != 1:
            raise Failure('Torrent ausente ou fora do diretório My-CT.')
        verb = args[0]
        if verb == 'status':
            return {'torrents': rows}
        method = {'pause': 'torrent_stop', 'resume': 'torrent_start', 'remove': 'torrent_remove'}[verb]
        params = {'ids': [key]}
        if verb == 'remove':
            params['delete_local_data'] = False
        rpc.call(method, params)
        return {'ok': True, 'hash': key}
    raise Failure('Uso: myct-torrent list | add MAGNET | add-metainfo-stdin | status/pause/resume/remove/delete-data HASH')

def main():
    os.umask(0o077)
    try:
        output = json.dumps(run(sys.argv[1:], Rpc()), ensure_ascii=True)
        if len(output.encode()) > LIMIT:
            raise Failure('Histórico excedeu 256 KiB; consulte pelo Transmission local.')
        print(output)
    except (OSError, TimeoutError, http.client.HTTPException):
        print('Transmission indisponível. Confira pacote transmission-daemon e myct-transmission.service.', file=sys.stderr)
        return 3
    except (Failure, ValueError, KeyError, TypeError) as error:
        print(str(error) if isinstance(error, Failure) else 'Resposta ou argumento inválido.', file=sys.stderr)
        return 2
    return 0

if __name__ == '__main__':
    sys.exit(main())
